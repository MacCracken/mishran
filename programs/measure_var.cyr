# TEMP top-level measurement program. DELETE after.
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "src/_measure.cyr"

fn mv_say(s): i64 { return sys_write(1, s, strlen(s)); }
fn mv_sayn(n): i64 {
    var buf = alloc(24);
    var k = fmt_int_buf(n, buf);
    store8(buf + k, 10);
    return sys_write(1, buf, k + 1);
}

fn main(): i64 {
    alloc_init();
    # var b[3]: how many u64 words fit before a neighbour is clobbered?
    mv_say("b3 write 3 words -> guard mask (0 = safe): "); mv_sayn(_measure_b3_words(3));
    mv_say("b3 write 4 words -> guard mask: ");           mv_sayn(_measure_b3_words(4));
    mv_say("b3 write 6 words -> guard mask: ");           mv_sayn(_measure_b3_words(6));
    mv_say("b3 write 7 words -> guard mask: ");           mv_sayn(_measure_b3_words(7));
    # var p[48]: how many bytes fit?
    mv_say("p48 write 48 bytes -> guard mask: ");         mv_sayn(_measure_p48_bytes(48));
    mv_say("p48 write 384 bytes -> guard mask: ");        mv_sayn(_measure_p48_bytes(384));
    mv_say("p48 write 385 bytes -> guard mask: ");        mv_sayn(_measure_p48_bytes(385));
    return 0;
}

var rc = main();
syscall(60, rc);
