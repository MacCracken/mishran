# --- error.cyr ---

# @public — stable API surface for mishran error handling.
# error.cyr — mishran audio-mixer / routing error codes + Result helpers.
#
# MishranErr is a 16-byte record so a consumer can map a mixer failure
# cleanly onto its own error taxonomy. Error codes are integer constants;
# for errors that carry context (a message pointer), use
# mishran_err_new(code, msg).
#
# MishranErr struct layout (16 bytes):
#   +0: code    — error code constant (one of the MISHRAN_* below)
#   +8: detail  — pointer to detail string (or 0)

# ================================================================
# Error code constants
# ================================================================

enum MishranErrCode {
    MISHRAN_OK              = 0;   # no error
    MISHRAN_ERR_OOM         = 1;   # allocation failed / ring-buffer alloc cap hit
    MISHRAN_ERR_NO_STREAM   = 2;   # referenced stream id not registered
    MISHRAN_ERR_FORMAT      = 3;   # unsupported/mismatched PCM format or channel count
    MISHRAN_ERR_OVERRUN     = 4;   # ring buffer overrun (producer outran consumer)
    MISHRAN_ERR_NO_SINK     = 5;   # no output sink open (router has no vani handle)
    MISHRAN_ERR_UNSUPPORTED = 6;   # valid request but a feature mishran can't do yet
    MISHRAN_ERR_SINK_WRITE  = 7;   # vani sink write failed after XRUN re-prepare
    MISHRAN_ERR_OTHER       = 99;  # catch-all
}

# ================================================================
# MishranErr struct
# ================================================================

# Create a MishranErr with code and an optional detail string (0 = none).
fn mishran_err_new(code, detail): i64 {
    var e = alloc(16);
    store64(e, code);
    store64(e + 8, detail);
    return e;
}

# Create a MishranErr with code only (no detail).
fn mishran_err(code): i64 {
    return mishran_err_new(code, 0);
}

# Get the error code.
fn mishran_err_code(e): i64 {
    return load64(e);
}

# Get the detail string pointer (or 0).
fn mishran_err_detail(e): i64 {
    return load64(e + 8);
}

# ================================================================
# Error name lookup — returns a cstring (never null).
# ================================================================

fn mishran_err_name(code): i64 {
    if (code == MISHRAN_OK)              { return "ok"; }
    if (code == MISHRAN_ERR_OOM)         { return "out of memory"; }
    if (code == MISHRAN_ERR_NO_STREAM)   { return "no such stream"; }
    if (code == MISHRAN_ERR_FORMAT)      { return "bad audio format"; }
    if (code == MISHRAN_ERR_OVERRUN)     { return "ring buffer overrun"; }
    if (code == MISHRAN_ERR_NO_SINK)     { return "no output sink"; }
    if (code == MISHRAN_ERR_UNSUPPORTED) { return "unsupported feature"; }
    if (code == MISHRAN_ERR_SINK_WRITE)  { return "sink write failed"; }
    if (code == MISHRAN_ERR_OTHER)       { return "other error"; }
    return "unknown error";
}

# Print an error name to stderr (fd 2).
fn mishran_err_print_name(code): i64 {
    var name = mishran_err_name(code);
    syscall(1, 2, name, strlen(name));
    return 0;
}

# --- stream.cyr ---

# @public — mishran per-app PCM stream + ring buffer.
# stream.cyr — a single application's audio stream: an id, a PCM format
# descriptor, and a lock-light single-producer/single-consumer ring buffer
# of interleaved sample frames feeding the mixer.
#
# One MshStream per sounding application. The app is the producer
# (msh_stream_write); the router pump is the consumer (msh_stream_read).
# Frames are interleaved: `channels` samples per frame. The ring stores
# raw samples (S16 = 2 bytes/sample via store16/load16); cap/head/tail are
# measured in SAMPLES so the frame math is `frames * channels`.

# ----------------------------------------------------------------
# MshFormat — sample encoding tag.
# ----------------------------------------------------------------
enum MshFormat {
    MSH_FMT_S16 = 0;   # signed 16-bit little-endian PCM (2 bytes/sample)
    MSH_FMT_F32 = 1;   # 32-bit float PCM (4 bytes/sample) — TODO(v0.2)
}

# ----------------------------------------------------------------
# MshStream struct layout (72 bytes):
#   +0:  id           — stream id (assigned by the router)
#   +8:  format       — MshFormat tag
#   +16: sample_rate  — frames per second (e.g. 48000)
#   +24: channels     — interleaved channel count (1 = mono, 2 = stereo)
#   +32: ring         — ptr to sample ring buffer (cap samples)
#   +40: cap          — ring capacity in SAMPLES
#   +48: head         — write cursor (samples, mod cap)
#   +56: tail         — read cursor  (samples, mod cap)
#   +64: gain         — per-stream volume, Q8 fixed-point (256 = unity, 0 = mute)
# ----------------------------------------------------------------

# Bytes-per-sample for a format. Returns 0 for an unknown tag.
fn msh_format_bytes(fmt): i64 {
    if (fmt == MSH_FMT_S16) { return 2; }
    if (fmt == MSH_FMT_F32) { return 4; }
    return 0;
}

# Allocate a new S16 stream with a ring sized for `ring_frames` frames.
# Returns a MshStream ptr, or 0 on allocation failure.
fn msh_stream_new(rate, ch): i64 {
    var s = alloc(72);
    if (s == 0) { return 0; }
    store64(s + 0, 0);              # id — router assigns on add
    store64(s + 8, MSH_FMT_S16);
    store64(s + 16, rate);
    store64(s + 24, ch);
    # Default ring: 16384 frames * channels samples, 2 bytes each (S16). Sized so
    # a client's per-write chunk (<= MSH_PUMP_FRAMES = 1024) always has headroom
    # once the pump has drained a tick — the server's backpressure latch depends
    # on the ring being strictly larger than a single write.
    var cap = 16384 * ch;
    if (cap == 0) { cap = 16384; }
    var ring = alloc(cap * 2);
    if (ring == 0) { return 0; }
    store64(s + 32, ring);
    store64(s + 40, cap);
    store64(s + 48, 0);            # head
    store64(s + 56, 0);            # tail
    store64(s + 64, 256);          # gain — Q8 unity (256 = 1.0)
    return s;
}

# Accessors.
fn msh_stream_id(s): i64          { return load64(s + 0); }
fn msh_stream_set_id(s, id): i64  { store64(s + 0, id); return 0; }
fn msh_stream_format(s): i64      { return load64(s + 8); }
fn msh_stream_rate(s): i64        { return load64(s + 16); }
fn msh_stream_channels(s): i64    { return load64(s + 24); }
fn msh_stream_ring(s): i64        { return load64(s + 32); }
fn msh_stream_cap(s): i64         { return load64(s + 40); }
fn msh_stream_head(s): i64        { return load64(s + 48); }
fn msh_stream_tail(s): i64        { return load64(s + 56); }

# Per-stream volume, Q8 fixed-point: 256 = unity (0 dB), 128 = half (-6 dB),
# 512 = 2x (+6 dB, may clip), 0 = mute. Applied by msh_mix during fan-in.
fn msh_stream_gain(s): i64        { return load64(s + 64); }
fn msh_stream_set_gain(s, g): i64 { store64(s + 64, g); return 0; }

# Samples currently readable in the ring (head - tail, mod cap).
fn msh_stream_avail(s): i64 {
    var head = load64(s + 48);
    var tail = load64(s + 56);
    var cap = load64(s + 40);
    var d = head - tail;
    if (d < 0) { d = d + cap; }
    return d;
}

# Free sample slots the ring can still accept (cap - 1 - avail; one slot stays
# empty to tell full from empty). Measured in SAMPLES (frames * channels). Used
# by the server's pending-write backpressure latch (msh_server_service).
fn msh_stream_free(s): i64 {
    var free = load64(s + 40) - 1 - msh_stream_avail(s);
    if (free < 0) { free = 0; }
    return free;
}

# Write `frames` interleaved frames from `buf` (S16 samples) into the ring.
# Returns the number of frames actually written (may be short on overrun).
# TODO(v0.2): format conversion (F32→S16), proper overrun policy / drop-oldest.
fn msh_stream_write(s, buf, frames): i64 {
    var ch = load64(s + 24);
    var ring = load64(s + 32);
    var cap = load64(s + 40);
    var head = load64(s + 48);
    var tail = load64(s + 56);
    var want = frames * ch;
    var i = 0;
    while (i < want) {
        var next = head + 1;
        if (next == cap) { next = 0; }
        if (next == tail) {
            # Ring full — stop (overrun). Return frames written so far.
            store64(s + 48, head);
            return i / ch;
        }
        store16(ring + head * 2, load16(buf + i * 2));
        head = next;
        i = i + 1;
    }
    store64(s + 48, head);
    return frames;
}

# Read up to `frames` interleaved frames from the ring into `out` (S16).
# Returns the number of frames actually read (short if the ring underflows;
# the caller/mixer treats missing frames as silence).
fn msh_stream_read(s, out, frames): i64 {
    var ch = load64(s + 24);
    var ring = load64(s + 32);
    var cap = load64(s + 40);
    var head = load64(s + 48);
    var tail = load64(s + 56);
    var want = frames * ch;
    var i = 0;
    while (i < want) {
        if (tail == head) {
            store64(s + 56, tail);
            return i / ch;
        }
        store16(out + i * 2, load16(ring + tail * 2));
        tail = tail + 1;
        if (tail == cap) { tail = 0; }
        i = i + 1;
    }
    store64(s + 56, tail);
    return frames;
}

# --- mix.cyr ---

# @public — mishran the mixing kernel.
# mix.cyr — sum many per-app streams into a single output frame buffer
# (fan-in), plus a resample stub. This is where the "many streams → one
# writer" fan-in actually happens numerically.
#
# msh_mix sums the S16 samples of `n` streams frame-by-frame into `out`
# with a hard clamp to the S16 range so a loud overlap doesn't wrap, each
# stream scaled by its per-stream Q8 gain first. A REAL (if simple) mixer
# body — per-stream gain now; no dither, no soft-knee yet.

# S16 sample bounds. Cyrius enum members must be plain numbers (no unary
# minus), so the minimum is expressed as `0 - 32768` inside the clamp.
enum MshS16 {
    MSH_S16_MAX = 32767;
}

# Clamp an accumulated i64 sample into the signed-16-bit range.
fn msh_clamp_s16(v): i64 {
    var lo = 0 - 32768;
    if (v > MSH_S16_MAX) { return MSH_S16_MAX; }
    if (v < lo) { return lo; }
    return v;
}

# Sign-extend a raw 16-bit sample (load16 gives an unsigned 0..65535) into
# a signed i64 so the summation arithmetic is correct.
fn msh_sext_s16(u): i64 {
    if (u >= 32768) { return u - 65536; }
    return u;
}

# Linear-resample `src_frames` interleaved S16 frames (`ch` channels) at
# `in_rate` into `out` at `out_rate`, up to `out_cap` frames. Per-channel
# linear interpolation via an integer phase accumulator (no float): output
# frame o samples source position o*in_rate/out_rate, interpolating between the
# two nearest source frames. Returns the output frame count produced
# (= src_frames*out_rate/in_rate, capped at out_cap); in_rate == out_rate is a
# straight copy. (`in` is a Cyrius keyword, hence `src`.)
# TODO(v0.2): polyphase / anti-alias filtering on downsample; F32 path.
fn msh_resample(src, src_frames, in_rate, out, out_cap, out_rate, ch): i64 {
    if (in_rate == 0) { return 0; }
    if (src_frames <= 0) { return 0; }
    var out_frames = (src_frames * out_rate) / in_rate;
    if (out_frames > out_cap) { out_frames = out_cap; }
    var o = 0;
    while (o < out_frames) {
        var posn = o * in_rate;                 # source position numerator (out_rate units)
        var idx = posn / out_rate;              # floor source frame
        var rem = posn - idx * out_rate;        # fractional numerator, [0, out_rate)
        var idx1 = idx + 1;
        if (idx1 >= src_frames) { idx1 = src_frames - 1; }
        var c = 0;
        while (c < ch) {
            var s0 = msh_sext_s16(load16(src + (idx * ch + c) * 2));
            var s1 = msh_sext_s16(load16(src + (idx1 * ch + c) * 2));
            var interp = s0 + ((s1 - s0) * rem) / out_rate;
            store16(out + (o * ch + c) * 2, msh_clamp_s16(interp));
            c = c + 1;
        }
        o = o + 1;
    }
    return out_frames;
}

# Mix `n` streams into `out` for `frames` interleaved frames at `sink_rate`.
#   streams   — ptr to an array of n MshStream ptrs (8 bytes each)
#   out       — S16 output buffer, frames*channels samples
#   frames    — frame count to produce (at the sink rate)
#   sink_rate — the router output rate; a stream at a different rate is
#               linear-resampled to it via msh_resample before summing.
# Channel count comes from the first stream (default stereo). Each stream is
# scaled by its per-stream Q8 gain, summed sample-by-sample, and clamped.
# Returns MISHRAN_OK.
# TODO(v0.2): F32 path; reuse router-owned scratch instead of the per-call alloc.
fn msh_mix(streams, n, out, frames, sink_rate): i64 {
    var ch = 2;
    if (n > 0) {
        var s0 = load64(streams + 0);
        if (s0 != 0) { ch = msh_stream_channels(s0); }
    }
    var total = frames * ch;

    # Zero the accumulator (out doubles as the running sum in S16 space).
    var i = 0;
    while (i < total) {
        store16(out + i * 2, 0);
        i = i + 1;
    }

    var scratch = alloc(total * 2);
    if (scratch == 0) { return MISHRAN_ERR_OOM; }

    var si = 0;
    while (si < n) {
        var s = load64(streams + si * 8);
        if (s != 0) {
            var g = msh_stream_gain(s);              # Q8 per-stream volume (256 = unity)
            var srate = msh_stream_rate(s);
            var got_frames = 0;
            if (srate == sink_rate) {
                got_frames = msh_stream_read(s, scratch, frames);
            } else {
                # Pull the source frames that map to `frames` output frames, then
                # linear-resample them up/down to the sink rate into scratch.
                var in_frames = (frames * srate) / sink_rate;
                if (in_frames < 1) { in_frames = 1; }
                var inbuf = alloc(in_frames * ch * 2);
                if (inbuf == 0) { return MISHRAN_ERR_OOM; }
                var pulled = msh_stream_read(s, inbuf, in_frames);
                got_frames = msh_resample(inbuf, pulled, srate, scratch, frames, sink_rate, ch);
            }
            var got_samples = got_frames * ch;
            var k = 0;
            while (k < got_samples) {
                var acc = msh_sext_s16(load16(out + k * 2));
                acc = acc + (msh_sext_s16(load16(scratch + k * 2)) * g) / 256;
                store16(out + k * 2, msh_clamp_s16(acc));
                k = k + 1;
            }
        }
        si = si + 1;
    }
    return MISHRAN_OK;
}

# Scale `count` interleaved S16 samples in `buf` by a Q8 gain (256 = unity,
# 0 = mute) IN PLACE, clamping each result to the S16 range. Drives the
# router's master output level (msh_router_pump); gain == 256 is a no-op fast
# path. Pure + unit-testable without a hardware sink.
fn msh_apply_gain(buf, count, gain): i64 {
    if (gain == 256) { return MISHRAN_OK; }
    var i = 0;
    while (i < count) {
        var v = (msh_sext_s16(load16(buf + i * 2)) * gain) / 256;
        store16(buf + i * 2, msh_clamp_s16(v));
        i = i + 1;
    }
    return MISHRAN_OK;
}

# --- route.cyr ---

# @public — mishran the single-writer router / fan-in server.
# route.cyr — the MshRouter owns the ONE hardware output sink (a vani
# handle) and the list of registered app streams. It is the answer to the
# agnos snd surface being single-writer: exactly one MshRouter holds that
# writer, and every app's MshStream fans in behind it via msh_mix.
#
# Lifecycle:
#   msh_router_new()            — allocate a router (sink not yet open)
#   msh_router_add(r, stream)   — register an app stream, assign an id
#   msh_router_remove(r, id)    — drop a stream by id
#   msh_router_pump(r)          — pull each stream → msh_mix → push to sink
#
# The pump loop is what runs on the router's own thread once the real vani
# sink is wired; at scaffold stage it mixes into an internal buffer and
# stops short of the device write.

# Max registered streams for the scaffold (fixed table; grows to a vec later).
enum MshRouterCap {
    MSH_MAX_STREAMS = 32;
    MSH_PUMP_FRAMES = 1024;   # frames mixed per pump tick
}

# ----------------------------------------------------------------
# MshRouter struct layout (56 bytes):
#   +0:  sink       — vani sink handle (0 = no sink open yet)
#   +8:  streams    — ptr to array of MSH_MAX_STREAMS stream ptrs (8 each)
#   +16: count      — number of registered streams
#   +24: next_id    — monotonic id allocator
#   +32: channels   — sink channel count (default 2, stereo)
#   +40: rate       — sink sample rate (default 48000)
#   +48: master     — master output volume, Q8 (256 = unity, 0 = mute)
# ----------------------------------------------------------------

# Allocate a router with an empty stream table and no sink.
# Returns a MshRouter ptr, or 0 on allocation failure.
fn msh_router_new(): i64 {
    var r = alloc(56);
    if (r == 0) { return 0; }
    var tbl = alloc(MSH_MAX_STREAMS * 8);
    if (tbl == 0) { return 0; }
    var i = 0;
    while (i < MSH_MAX_STREAMS) {
        store64(tbl + i * 8, 0);
        i = i + 1;
    }
    store64(r + 0, 0);            # sink — opened later via vani
    store64(r + 8, tbl);
    store64(r + 16, 0);          # count
    store64(r + 24, 1);          # next_id starts at 1
    store64(r + 32, 2);          # channels — stereo
    store64(r + 40, 48000);      # rate
    store64(r + 48, 256);        # master output gain — Q8 unity
    return r;
}

# Accessors.
fn msh_router_sink(r): i64      { return load64(r + 0); }
fn msh_router_streams(r): i64   { return load64(r + 8); }
fn msh_router_count(r): i64     { return load64(r + 16); }
fn msh_router_channels(r): i64  { return load64(r + 32); }
fn msh_router_rate(r): i64      { return load64(r + 40); }

# Master output volume, Q8 fixed-point (256 = unity, 128 = -6 dB, 0 = mute).
# Applied to the mixed block in msh_router_pump just before the sink write.
fn msh_router_gain(r): i64      { return load64(r + 48); }
fn msh_router_set_gain(r, g): i64 { store64(r + 48, g); return 0; }

# Open the vani hardware sink for this router. `card`/`device` select the ALSA
# PCM endpoint (both ignored on agnos, where the sovereign snd stream is
# claimed). Configures the sink to the router's rate/channels at S16_LE and
# prepares it. Idempotent — a second call with a sink already open is a no-op.
# Returns MISHRAN_OK, or MISHRAN_ERR_NO_SINK if the device could not be opened
# or configured.
fn msh_router_open(r, card, device): i64 {
    if (r == 0)             { return MISHRAN_ERR_NO_SINK; }
    if (load64(r + 0) != 0) { return MISHRAN_OK; }
    var dev = audio_open_playback(card, device);
    if (dev == 0)           { return MISHRAN_ERR_NO_SINK; }
    var rc = audio_set_params(dev, msh_router_rate(r), msh_router_channels(r), 16);
    if (rc < 0) {
        audio_close(dev);
        return MISHRAN_ERR_NO_SINK;
    }
    audio_prepare(dev);
    store64(r + 0, dev);
    return MISHRAN_OK;
}

# Register a stream. Assigns it the next id, stores it in the first free
# slot, bumps count. Returns the assigned stream id, or MISHRAN_ERR_OOM if
# the table is full.
fn msh_router_add(r, stream): i64 {
    var tbl = load64(r + 8);
    var i = 0;
    while (i < MSH_MAX_STREAMS) {
        if (load64(tbl + i * 8) == 0) {
            var id = load64(r + 24);
            msh_stream_set_id(stream, id);
            store64(tbl + i * 8, stream);
            store64(r + 24, id + 1);
            store64(r + 16, load64(r + 16) + 1);
            return id;
        }
        i = i + 1;
    }
    return MISHRAN_ERR_OOM;
}

# Remove a stream by id. Returns MISHRAN_OK, or MISHRAN_ERR_NO_STREAM if the
# id was not registered.
fn msh_router_remove(r, id): i64 {
    var tbl = load64(r + 8);
    var i = 0;
    while (i < MSH_MAX_STREAMS) {
        var s = load64(tbl + i * 8);
        if (s != 0) {
            if (msh_stream_id(s) == id) {
                store64(tbl + i * 8, 0);
                store64(r + 16, load64(r + 16) - 1);
                return MISHRAN_OK;
            }
        }
        i = i + 1;
    }
    return MISHRAN_ERR_NO_STREAM;
}

# One pump tick: pull MSH_PUMP_FRAMES from every registered stream, mix them
# down via msh_mix, and push the mixed block to the vani sink. The sink must
# already be open (msh_router_open); a router with no sink returns
# MISHRAN_ERR_NO_SINK so the caller knows the block was mixed but not emitted.
# Returns MISHRAN_OK on a clean mix + write, or an error code.
#
# BLOCKING: the sink write blocks until the DAC can take the block, so a SINGLE-PROC
# feed+pump loop (e.g. mishtone) is PACED to real time by this call. A multi-proc
# daemon serving concurrent client procs must use msh_router_pump_nb instead — a
# blocking write there holds the CPU with preemption disabled and starves the client
# (the kernel can't preempt a blocking syscall — agnos-blocking-syscall-yield-fix).
# TODO(v0.2): run this loop on the router's own thread; reuse a router-owned
#       mixbuf instead of the per-tick alloc below.
fn msh_router_pump(r): i64 {
    var ch = load64(r + 32);
    var total = MSH_PUMP_FRAMES * ch;
    var mixbuf = alloc(total * 2);
    if (mixbuf == 0) { return MISHRAN_ERR_OOM; }

    var streams = load64(r + 8);
    var rc = msh_mix(streams, MSH_MAX_STREAMS, mixbuf, MSH_PUMP_FRAMES, load64(r + 40));
    if (rc != MISHRAN_OK) { return rc; }

    # Apply the master output level to the mixed block (Q8; no-op at unity).
    msh_apply_gain(mixbuf, total, load64(r + 48));

    # Push the mixed block to the vani sink. audio_write returns the frame count
    # accepted, or negative on error; -EPIPE (0 - 32) is an ALSA underrun — re-prepare
    # and replay the block once (the doom/dhvani idiom, since the core audio_* shim
    # leaves XRUN recovery to the caller).
    var sink = load64(r + 0);
    if (sink == 0) { return MISHRAN_ERR_NO_SINK; }
    var w = audio_write(sink, mixbuf, MSH_PUMP_FRAMES);
    if (w == 0 - 32) {
        audio_prepare(sink);
        w = audio_write(sink, mixbuf, MSH_PUMP_FRAMES);
    }
    if (w < 0) { return MISHRAN_ERR_SINK_WRITE; }
    return MISHRAN_OK;
}

# Cooperative, NON-blocking pump for a MULTI-PROC daemon (mishrand / mishduplex) that
# services concurrent client procs. On agnos: emit a block ONLY when the DAC ring has
# room for a WHOLE block (audio_avail #69); otherwise return WITHOUT mixing, so the
# stream data stays buffered and the daemon loop can go back to msh_server_poll +
# sched_yield. This is the crux of multi-proc audio: a blocking audio_write — or a
# loop-until-whole-block write — would HOG the pump, stop draining the concurrent
# client, and starve the mix into silence (the kernel can't preempt a blocking syscall:
# the shared per-CPU syscall kstack, the serial-kstack invariant —
# agnos-blocking-syscall-yield-fix). We write at most one block per call, DAC-paced, so
# the daemon stays responsive and the procs interleave; the DAC IRQ draining the ring
# paces us. On Linux (real preemption) this delegates to the blocking pump.
fn msh_router_pump_nb(r): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var sink = load64(r + 0);
    if (sink == 0) { return MISHRAN_ERR_NO_SINK; }
    if (audio_avail(sink) < MSH_PUMP_FRAMES) { return MISHRAN_OK; }   # no room yet -> next tick
    var ch = load64(r + 32);
    var total = MSH_PUMP_FRAMES * ch;
    var mixbuf = alloc(total * 2);
    if (mixbuf == 0) { return MISHRAN_ERR_OOM; }
    var streams = load64(r + 8);
    var rc = msh_mix(streams, MSH_MAX_STREAMS, mixbuf, MSH_PUMP_FRAMES, load64(r + 40));
    if (rc != MISHRAN_OK) { return rc; }
    msh_apply_gain(mixbuf, total, load64(r + 48));            # master level (Q8; no-op at unity)
    var wn = audio_write_nb(sink, mixbuf, MSH_PUMP_FRAMES);   # room was checked -> full block fits
    if (wn < 0) { return MISHRAN_ERR_SINK_WRITE; }
    return MISHRAN_OK;
    #else
    return msh_router_pump(r);
    #endif
}

# Drain and close the vani sink, releasing the single hardware writer. Safe to
# call when no sink is open (no-op). After this the router can be re-opened
# with msh_router_open. Returns MISHRAN_OK.
fn msh_router_close(r): i64 {
    if (r == 0) { return MISHRAN_OK; }
    var sink = load64(r + 0);
    if (sink != 0) {
        audio_drain(sink);
        audio_close(sink);
        store64(r + 0, 0);
    }
    return MISHRAN_OK;
}

# --- proto.cyr ---

# @public — mishran the wire protocol.
# proto.cyr — the message format spoken between an app (client) and the mishran
# router (server) over TCP loopback (see transport.cyr). Modeled on setu's
# codec/proto: a message is 8-byte words — kind, argc, then argc args.
#
# Two ways to deliver PCM:
#   MSH_WRITE     — the args are followed on the wire by a raw S16 PCM payload
#                   (nframes*channels*2 bytes) NOT part of the message struct.
#                   Simple, but the payload must stay under the ~2 KB agnos
#                   loopback recv window, so per-write chunks are small (256 fr).
#   MSH_WRITE_SHM — the PCM lives out-of-band in a shared buffer (shm.cyr); the
#                   message carries only [nframes, buf_id]. Lifts the window
#                   ceiling; the server ACKs (MSH_ACK) once it has copied the
#                   block out, so the client can safely reuse the buffer.
#
# proto.cyr is dep-free (no stdlib beyond load64/store64/alloc) so it sits at the
# head of the server modules in the include chain.

enum MshOp {
    MSH_HELLO     = 1;   # C->S: args [rate, channels] — register a stream
    MSH_WELCOME   = 2;   # S->C: args [stream_id]      — assigned id
    MSH_WRITE     = 3;   # C->S: args [nframes] + inline PCM payload (nframes*ch*2 bytes)
    MSH_GAIN      = 4;   # C->S: args [gain_q8]        — set this stream's volume
    MSH_BYE       = 5;   # C->S: no args               — disconnect
    MSH_ERR       = 6;   # S->C: args [code]           — protocol error
    MSH_WRITE_SHM = 7;   # C->S: args [nframes, buf_id] — PCM out-of-band in shm buffer buf_id
    MSH_ACK       = 8;   # S->C: args [buf_id]         — buffer consumed; client may reuse it
}

# A message: kind (+0), argc (+8), up to MSH_MAX_ARGS args (+16..). 48 bytes.
enum MshProto {
    MSH_MAX_ARGS = 4;
    MSH_MSG_SZ   = 48;
    MSH_HDR      = 16;   # kind + argc, 8 bytes each
}

fn msh_msg_new(): i64 {
    var m = alloc(MSH_MSG_SZ);
    store64(m + 0, 0);
    store64(m + 8, 0);
    return m;
}

fn msh_msg_kind(m): i64    { return load64(m + 0); }
fn msh_msg_argc(m): i64    { return load64(m + 8); }
fn msh_msg_arg(m, i): i64  { return load64(m + 16 + i * 8); }

# Set kind + argc; args go in via msh_msg_set_arg.
fn msh_msg_set(m, kind, argc): i64 {
    store64(m + 0, kind);
    store64(m + 8, argc);
    return 0;
}
fn msh_msg_set_arg(m, i, v): i64 { store64(m + 16 + i * 8, v); return 0; }

# Encode `m` into `buf` (cap bytes). Returns the byte length ((2+argc)*8), or -1
# on a bad argc / insufficient cap.
fn msh_encode(m, buf, cap): i64 {
    var argc = load64(m + 8);
    if (argc < 0) { return 0 - 1; }
    if (argc > MSH_MAX_ARGS) { return 0 - 1; }
    var total = (2 + argc) * 8;
    if (total > cap) { return 0 - 1; }
    store64(buf + 0, load64(m + 0));
    store64(buf + 8, argc);
    var i = 0;
    while (i < argc) { store64(buf + 16 + i * 8, load64(m + 16 + i * 8)); i = i + 1; }
    return total;
}

# Decode a message from `buf` (n bytes) into `m`. Returns the total byte length,
# or -1 on a short buffer / bad argc.
fn msh_decode(buf, n, m): i64 {
    if (n < 16) { return 0 - 1; }
    var argc = load64(buf + 8);
    if (argc < 0) { return 0 - 1; }
    if (argc > MSH_MAX_ARGS) { return 0 - 1; }
    var total = (2 + argc) * 8;
    if (n < total) { return 0 - 1; }
    store64(m + 0, load64(buf + 0));
    store64(m + 8, argc);
    var i = 0;
    while (i < argc) { store64(m + 16 + i * 8, load64(buf + 16 + i * 8)); i = i + 1; }
    return total;
}

# --- shm.cyr ---

# @public — mishran SHARED-BUFFER PCM transport (out-of-band, COPY-based).
#
# The audio counterpart of setu's buf.cyr. Moves the PCM payload OFF the TCP
# wire and into a buffer owned by the kernel/OS and keyed by an integer id: the
# client writes rendered frames into the buffer, sends a tiny MSH_WRITE_SHM
# control message carrying the id (NOT the samples), and the server reads them
# back out. This sidesteps the agnos single-CPU two-proc TCP flow-control window
# (the loopback recv ring is ~2 KB, but a useful audio block is many KB) with a
# single kernel/OS copy each way — negligible vs the block, and it lifts the old
# 256-frame per-write ceiling the inline-TCP path needed to stay under the window.
# See agnosticos/docs/development/planning/blocking-syscall-concurrency.md
# ("Shared-memory PCM transport for mishran").
#
# COPY-based (not shared-page-mapped) on purpose — the buffer is OWNED by the
# kernel/OS, never mapped into a process's own arena, so a client that exits right
# after a write can't free pages the server is still reading (agnos
# proc_free_address_space frees every arena page on exit). The id is a small
# integer sent over mishran's TCP wire — no fd passing — so it rides the transport
# unchanged on both targets.
#   Linux — a tmpfs file /dev/shm/mishran-pcm-<id>: the client write()s it, the
#           server read()s it. Pure userland; no kernel change.
#   agnos — the kernel shm syscalls (shm_create #71 / shm_write #72 / shm_read #73
#           / shm_free #74, cyrius >= 6.4.33). The same primitives setu's present
#           buffer uses.
#
# shm.cyr is dep-light (string/fmt/syscalls from the stdlib chain) and dep-free of
# the other mishran modules, so it sits near the head of the server band.

var _msh_shm_counter = 0;

# Build "/dev/shm/mishran-pcm-<buf_id>\0" into `out` (caller supplies >= 48 bytes).
fn msh_shm_path(buf_id, out): i64 {
    var prefix = "/dev/shm/mishran-pcm-";
    var plen = strlen(prefix);
    var i = 0;
    while (i < plen) { store8(out + i, load8(prefix + i)); i = i + 1; }
    var nl = fmt_int_buf(buf_id, out + plen);
    store8(out + plen + nl, 0);
    return 0;
}

# Reserve a fresh shared buffer of `size` bytes. Returns a buffer id (> 0) or -1.
# On Linux this creates + pre-sizes the tmpfs file; fill it with msh_shm_write.
fn msh_shm_create(size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_shm_create(size);           # shm_create#71 -> kernel buffer id (>=1) / -1
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pid = syscall(39);                 # getpid — per-proc uniqueness seed
    _msh_shm_counter = _msh_shm_counter + 1;
    var id = pid * 100000 + _msh_shm_counter;
    var path[48];
    msh_shm_path(id, &path);
    var fd = sys_open(&path, 577, 384);    # O_WRONLY|O_CREAT|O_TRUNC (1|64|512), mode 0600
    if (fd < 0) { return 0 - 1; }
    syscall(77, fd, size);                 # ftruncate to size (pre-size)
    sys_close(fd);
    return id;
    #endif
}

# Copy `size` bytes from `src` INTO shared buffer `buf_id`. Returns 0 / -1.
fn msh_shm_write(buf_id, src, size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_shm_write(buf_id, src, size);   # shm_write#72: user src -> kernel buffer
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var path[48];
    msh_shm_path(buf_id, &path);
    var fd = sys_open(&path, 1, 0);        # O_WRONLY
    if (fd < 0) { return 0 - 1; }
    var sent = 0;
    while (sent < size) {
        var w = sys_write(fd, src + sent, size - sent);
        if (w <= 0) { sys_close(fd); return 0 - 1; }
        sent = sent + w;
    }
    sys_close(fd);
    return 0;
    #endif
}

# Copy `size` bytes OUT of shared buffer `buf_id` into `dst`. Returns 0 / -1.
fn msh_shm_read(buf_id, dst, size): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_shm_read(buf_id, dst, size);    # shm_read#73: kernel buffer -> user dst
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var path[48];
    msh_shm_path(buf_id, &path);
    var fd = sys_open(&path, 0, 0);        # O_RDONLY
    if (fd < 0) { return 0 - 1; }
    var got = 0;
    while (got < size) {
        var r = sys_read(fd, dst + got, size - got);
        if (r <= 0) { sys_close(fd); return 0 - 1; }
        got = got + r;
    }
    sys_close(fd);
    return 0;
    #endif
}

# Destroy the buffer (client owner). Returns 0 / -1.
fn msh_shm_free(buf_id): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_shm_free(buf_id);           # shm_free#74
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var path[48];
    msh_shm_path(buf_id, &path);
    return syscall(87, &path);             # unlink
    #endif
}

# --- transport.cyr ---

# @public — mishran the server/client TCP transport.
#
# ⛔⛔ WRONG PREMISE — TCP-ON-LOOPBACK IS RETIRED AS A LOCAL TRANSPORT (2026-08-03).
# This file was modeled 1:1 on setu's reference transport, and it inherited setu's mistake.
# On agnos, BEFORE `net_src_for` (agnos 1.56.34), the handshake could not close on an ordinary
# boot: every outbound segment claimed `net_ip` as its source, so a SYN to 127.0.0.1 was answered
# on a 4-tuple the client's own conn could not match. The only agnos runs that passed IN THAT ERA
# did so under the `MISHRAN_DUPLEX_SELFTEST` kernel hook, which assigned `net_ip = 0x7F000001` and
# made src and dst agree by accident. That hook and its smokes are DELETED, and every "two-proc
# audio on agnos" green resting on them is a FALSE GREEN (see this repo's CHANGELOG retractions).
# ⚠ SCOPE, both ways: `net_src_for` fixed the source-selection mechanism, and setu's equivalent
# path DID connect un-rigged afterwards (`aethersafha-clients-test.py`, QEMU `-smp 1`, 2026-08-02).
# mishran's own 7701 wire was never re-tested post-fix, so the honest statement is that it was
# NEVER HONESTLY DEMONSTRATED on agnos — not that it could not work. Do not claim either.
# ⛔ The claim below — "cross-platform by construction ... the same wire runs on Linux and the
# sovereign kernel" — was NOT ESTABLISHED for agnos. The replacement is the agnos socket (`naadi`), agnos
# `docs/development/planning/ipc.md` §9/§10; per §10.3 this whole socket body comes out,
# including the `SO_REUSEADDR` that exists only to survive a restart race a placed channel
# cannot have. Do NOT build on this file, and do NOT copy it into a new local IPC path.
# ⚠ TCP itself is fine FOR THE NETWORK — what died is a local transport riding it.
#
# transport.cyr — TCP over loopback (127.0.0.1 : MSH_TCP_PORT) via the cyrius
# `net.cyr` socket layer. net.cyr routes to Linux BSD sockets on the host AND to agnos's kernel
# TCP band (sock_connect #47 / sock_listen #56 / sock_accept #57, tagged-fd send/recv #48/#49)
# on agnos.
#
# Two agnos socket semantics the framing absorbs (both #ifdef-guarded so Linux is
# byte-identical): sock_recv (#49) is NON-BLOCKING with INVERTED signals
# (0 = would-block, -1 = EOF) vs Linux (0 = EOF, -1 = EAGAIN on a nonblocking fd);
# sock_send (#48) may send < len, so writes loop.

var MSH_TCP_PORT = 7701;   # mishran's well-known loopback audio-server port (setu = 7700)

# Connect to the mishran server (loopback : MSH_TCP_PORT). Returns the connected
# fd (>= 0), or -2 (socket) / -3 (connect).
fn msh_connect(): i64 {
    var s = tcp_socket();
    if (is_ok(s) == 0) { return 0 - 2; }
    var fd = result_unwrap(s);
    if (is_ok(sock_connect(fd, INADDR_LOOPBACK(), MSH_TCP_PORT)) == 0) {
        sock_close(fd);
        return 0 - 3;
    }
    return fd;
}

# Bind + listen on the mishran endpoint. Returns the listening fd (>= 0), or
# -2 (socket) / -3 (bind) / -4 (listen). Non-blocking so msh_accept polls.
fn msh_listen(): i64 {
    var s = tcp_socket();
    if (is_ok(s) == 0) { return 0 - 2; }
    var fd = result_unwrap(s);
    #ifndef CYRIUS_TARGET_AGNOS
    sock_reuse(fd);                                  # SO_REUSEADDR — rebind after a restart
    #endif
    if (is_ok(sock_bind(fd, INADDR_LOOPBACK(), MSH_TCP_PORT)) == 0) { sock_close(fd); return 0 - 3; }
    if (is_ok(sock_listen(fd, 8)) == 0) { sock_close(fd); return 0 - 4; }
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(fd);                        # accept polls (agnos accept is already non-blocking)
    #endif
    return fd;
}

# Accept the next pending client on `sfd`. Returns the client fd (>= 0), or -5
# when none is pending. Non-blocking on both targets. The accepted fd is set
# non-blocking (Linux) so the server can poll each client without stalling.
fn msh_accept(sfd): i64 {
    var a = sock_accept(sfd);
    if (is_ok(a) == 0) { return 0 - 5; }             # EAGAIN / no client pending
    var cfd = result_unwrap(a);
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(cfd);
    #endif
    return cfd;
}

# Write EXACTLY `n` bytes from `buf` to `fd`, looping over partial sends. Returns
# `n` (>= 0) or -7 on a write error.
fn msh_write_all(fd, buf, n): i64 {
    var sent = 0;
    while (sent < n) {
        var w = sys_write(fd, buf + sent, n - sent);
        if (w < 0) { return 0 - 7; }                # hard error / peer closed
        if (w == 0) {                               # would-block (send window full)
            #ifdef CYRIUS_TARGET_AGNOS
            sys_sched_yield();                      # DONATE the slice so the server drains the ring.
            # Must be sched_yield #44, NOT sleep_ms: sleep_ms holds preempt off, so a
            # client whose send window is full would spin-sleep without ever letting the
            # server run to drain it — a deadlock (agnos-blocking-syscall-yield-fix).
            #endif
        } else {
            sent = sent + w;
        }
    }
    return n;
}

# Encode `m` into the caller-supplied wire buffer `buf` (>= MSH_MSG_SZ) and write
# the whole frame — ALLOC-FREE, for hot paths (the client's per-block write) that
# must not churn the bump heap: on a bump allocator with no per-object free, a
# per-block alloc leaks unboundedly and a long-running player OOMs. Returns bytes
# written (> 0), an encode error (< 0), or -7 on a write error. Mirrors the server's
# msh_srv_ack / msh_try_read_msg caller-owned-buffer pattern.
fn msh_send_buf(fd, m, buf): i64 {
    var enc = msh_encode(m, buf, MSH_MSG_SZ);
    if (enc < 0) { return enc; }
    if (msh_write_all(fd, buf, enc) < 0) { return 0 - 7; }
    return enc;
}

# Allocating convenience wrapper over msh_send_buf — for ONE-SHOT callers (the
# connect HELLO, the server's WELCOME reply) where a single bump alloc never
# accumulates. Hot paths pass their own reused buffer to msh_send_buf directly.
fn msh_send(fd, m): i64 {
    return msh_send_buf(fd, m, alloc(MSH_MSG_SZ));
}

# Blocking read of >= 1 byte into `buf` (cap `cap`). Absorbs agnos's non-blocking
# recv (0 = would-block → yield + bounded retry) vs Linux's blocking read
# (0 = EOF). Returns bytes (> 0) or -6 on EOF / error / timeout.
fn msh_read_blk(fd, buf, cap): i64 {
    var tries = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: recv is non-blocking; DONATE the slice (sched_yield #44) so the peer runs
    # to produce the bytes, then retry. Not sleep_ms — that holds preempt off and would
    # keep the peer from ever running (agnos-blocking-syscall-yield-fix). The cap is a
    # generous safety net against a silent-but-alive peer (a dead peer returns r<0 and
    # breaks immediately); each yield is a full peer-slice, so this is far longer than
    # the old 5000*2ms wall clock without falsely timing out a cooperative exchange.
    while (tries <= 2000000) {
        var r = sys_read(fd, buf, cap);
        if (r < 0) { return 0 - 6; }               # -1 = EOF / error
        if (r > 0) { return r; }                   # got bytes
        tries = tries + 1;                          # r == 0 → would-block
        sys_sched_yield();
    }
    return 0 - 6;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    while (tries <= 2000000) {                       # Linux: nonblocking fd → busy-spin on EAGAIN
        var r = sys_read(fd, buf, cap);             # (loopback delivers in microseconds; bounded)
        if (r == 0) { return 0 - 6; }              # 0 = EOF on Linux
        if (r > 0) { return r; }                   # got bytes
        tries = tries + 1;                          # r < 0 = EAGAIN
    }
    return 0 - 6;
    #endif
}

# Read EXACTLY `n` bytes into `buf`, looping over short/would-block reads. Returns
# `n` (>= 0) or -6 on EOF/error.
fn msh_read_exact(fd, buf, n): i64 {
    var got = 0;
    while (got < n) {
        var r = msh_read_blk(fd, buf + got, n - got);
        if (r <= 0) { return 0 - 6; }
        got = got + r;
    }
    return got;
}

# Blocking read of ONE length-framed message into `m` (header gives argc → total
# (2+argc)*8 bytes) using the caller-supplied wire buffer `buf` (>= MSH_MSG_SZ) —
# ALLOC-FREE, the read mirror of msh_send_buf for the client's per-ACK wait loop.
# Returns the frame length (> 0), -6 on EOF/short read, or -1 on a bad frame.
fn msh_read_msg_buf(fd, m, buf): i64 {
    if (msh_read_exact(fd, buf, 16) < 0) { return 0 - 6; }
    var argc = load64(buf + 8);
    if (argc < 0) { return 0 - 1; }
    if (argc > MSH_MAX_ARGS) { return 0 - 1; }
    var total = (2 + argc) * 8;
    if (total > 16) {
        if (msh_read_exact(fd, buf + 16, total - 16) < 0) { return 0 - 6; }
    }
    return msh_decode(buf, total, m);
}

# Allocating convenience wrapper over msh_read_msg_buf — for the ONE-SHOT client
# WELCOME handshake. The per-ACK wait loop passes its reused buffer to
# msh_read_msg_buf directly.
fn msh_read_msg(fd, m): i64 {
    return msh_read_msg_buf(fd, m, alloc(MSH_MSG_SZ));
}

# NON-BLOCKING read of ONE message into `m` for the server poll. Returns 1 with a
# decoded message, 0 when nothing is pending (would-block), or -1 on EOF/error.
# Once a header byte arrives the rest is read blocking (bounded), so a message is
# never left half-consumed. `buf` is a caller-supplied wire scratch buffer of >=
# MSH_MSG_SZ bytes (the server owns one reusable buffer) — this is polled on EVERY
# slot EVERY tick, so allocating it here would leak unboundedly on a long daemon.
fn msh_try_read_msg(fd, m, buf): i64 {
    var r = sys_read(fd, buf, 16);
    #ifdef CYRIUS_TARGET_AGNOS
    if (r == 0) { return 0; }                      # would-block → nothing pending
    if (r < 0)  { return 0 - 1; }                  # EOF / error
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (r < 0)  { return 0; }                      # EAGAIN on a nonblocking fd → nothing pending
    if (r == 0) { return 0 - 1; }                  # EOF on Linux
    #endif
    if (r < 16) { if (msh_read_exact(fd, buf + r, 16 - r) < 0) { return 0 - 1; } }
    var argc = load64(buf + 8);
    if (argc < 0) { return 0 - 1; }
    if (argc > MSH_MAX_ARGS) { return 0 - 1; }
    var total = (2 + argc) * 8;
    if (total > 16) { if (msh_read_exact(fd, buf + 16, total - 16) < 0) { return 0 - 1; } }
    if (msh_decode(buf, total, m) < 0) { return 0 - 1; }
    return 1;
}

# --- server.cyr ---

# @public — mishran the routing SERVER + the app-facing client.
# server.cyr — the piece that lets many apps ROUTE through the mixer instead of
# each grabbing the single vani writer. The server owns an MshRouter + a listener
# (transport.cyr) and maps each connected client to one MshStream. A client
# (jalwa, a game, …) connects, HELLOs its format, and streams PCM + gain; the
# server writes each into its stream's ring, and msh_router_pump mixes them all
# down to the one hardware sink.
#
# Depends on route.cyr (the router), stream.cyr (the per-client stream),
# transport.cyr (TCP), and proto.cyr (the wire messages).

enum MshServerConf {
    MSH_MAX_CLIENTS = 16;
    MSH_SLOT_SZ     = 40;   # per-client slot size (see the table layout below)
}

# MshServer: +0 listen fd, +8 router, +16 clients table ptr, then three server-owned
# REUSABLE buffers so the per-poll / per-block serving path allocates NOTHING (a
# bump-allocator daemon must never alloc in its hot loop — nothing frees, so it would
# leak unboundedly and OOM mid-stream): +24 a reused MshMsg struct for the poll
# decode + replies, +32 a reused wire read buffer (MSH_MSG_SZ) for msh_try_read_msg,
# +40 a grow-on-demand PCM copy-out scratch ptr with +48 its byte capacity. alloc(56).
#
# clients table: MSH_MAX_CLIENTS slots of [fd (+0), stream (+8), pending_frames
# (+16), pending_buf (+24), last_buf (+32)] = MSH_SLOT_SZ (40) bytes each. fd == 0 =
# free slot; stream == 0 = accepted but not yet HELLO'd; pending_frames != 0 = a
# WRITE payload deferred for backpressure. pending_buf: if the deferred payload came
# in over shm (MSH_WRITE_SHM), pending_buf != 0 holds the shm buffer id (the bytes
# sit safely in the client-owned buffer, not the socket); if 0, the deferred payload
# is legacy inline PCM still in the socket (MSH_WRITE). last_buf: the most recent shm
# buffer id this client announced (its single reused out-of-band buffer). On an
# ABNORMAL drop (EOF/error, no BYE) the server frees it — the client can't, and the
# agnos kernel keeps only SHM_MAX=16 slots, so one stranded buffer per crashed client
# would exhaust them. Zeroed on a clean BYE (the client frees its own on close —
# clearing avoids a double-free that could land on a since-reused slot id).

# Create a server around `router`: bind + listen. Returns a *MshServer, or 0 if
# the listener could not be opened.
fn msh_server_new(router): i64 {
    var lfd = msh_listen();
    if (lfd < 0) { return 0; }
    var s = alloc(56);
    var tbl = alloc(MSH_MAX_CLIENTS * MSH_SLOT_SZ);
    var i = 0;
    while (i < MSH_MAX_CLIENTS) {
        store64(tbl + i * MSH_SLOT_SZ, 0);
        store64(tbl + i * MSH_SLOT_SZ + 8, 0);
        store64(tbl + i * MSH_SLOT_SZ + 16, 0);
        store64(tbl + i * MSH_SLOT_SZ + 24, 0);
        store64(tbl + i * MSH_SLOT_SZ + 32, 0);
        i = i + 1;
    }
    store64(s + 0, lfd);
    store64(s + 8, router);
    store64(s + 16, tbl);
    store64(s + 24, msh_msg_new());       # reusable decode/reply message (poll path)
    store64(s + 32, alloc(MSH_MSG_SZ));    # reusable wire read buffer (msh_try_read_msg)
    store64(s + 40, 0);                    # PCM copy-out scratch ptr (grow-on-demand)
    store64(s + 48, 0);                    # PCM scratch capacity (bytes)
    return s;
}

fn msh_server_lfd(s): i64    { return load64(s + 0); }
fn msh_server_router(s): i64 { return load64(s + 8); }
fn msh_server_msg(s): i64    { return load64(s + 24); }
fn msh_server_rbuf(s): i64   { return load64(s + 32); }

# Return a PCM copy-out scratch buffer of at least `need` bytes, GROWING (and
# leaking the smaller prior buffer into the bump heap) only when a block exceeds the
# current capacity. Steady-state blocks are a fixed size (<= MSH_SHM_BLOCK_FRAMES),
# so this grows a bounded handful of times then never again — the copy-out stops
# allocating per block. Returns 0 on OOM.
fn msh_server_pcm(s, need): i64 {
    if (load64(s + 48) >= need) { return load64(s + 40); }
    var buf = alloc(need);
    if (buf == 0) { return 0; }
    store64(s + 40, buf);
    store64(s + 48, need);
    return buf;
}

# Register an accepted client fd in the first free slot (stream = 0 until HELLO).
# Returns 0, or -1 (table full → fd closed).
fn msh_server_add_client(s, fd): i64 {
    var tbl = load64(s + 16);
    var i = 0;
    while (i < MSH_MAX_CLIENTS) {
        if (load64(tbl + i * MSH_SLOT_SZ) == 0) {
            store64(tbl + i * MSH_SLOT_SZ, fd);
            store64(tbl + i * MSH_SLOT_SZ + 8, 0);
            store64(tbl + i * MSH_SLOT_SZ + 16, 0);
            store64(tbl + i * MSH_SLOT_SZ + 24, 0);
            store64(tbl + i * MSH_SLOT_SZ + 32, 0);
            return 0;
        }
        i = i + 1;
    }
    sock_close(fd);
    return 0 - 1;
}

# Drop a client slot: unregister its stream from the router (if any) + close fd.
fn msh_server_drop(s, slot): i64 {
    var st = load64(slot + 8);
    if (st != 0) { msh_router_remove(load64(s + 8), msh_stream_id(st)); }
    var fd = load64(slot + 0);
    if (fd != 0) { sock_close(fd); }
    # Reclaim the client's out-of-band shm buffer on an ABNORMAL drop: a clean BYE
    # zeros last_buf first (the client frees its own on close), so a non-zero last_buf
    # here means the client vanished without a BYE and can never free it. Cross-process
    # free is valid (the agnos shm table is global + id-keyed) and a stale/double free
    # is a graceful no-op; skipping it would strand one of only SHM_MAX=16 kernel slots
    # per crashed client, eventually refusing all new clients.
    var lb = load64(slot + 32);
    if (lb != 0) { msh_shm_free(lb); }
    store64(slot + 0, 0);
    store64(slot + 8, 0);
    store64(slot + 16, 0);
    store64(slot + 24, 0);
    store64(slot + 32, 0);
    return 0;
}

# Send an MSH_ACK(buf_id) to the client on `fd`: the server has copied that shm
# buffer's PCM into the stream ring, so the client may safely reuse it. Tiny (a
# 24-byte control frame) — always fits the loopback window, never backpressures.
#
# ALLOC-FREE: an ACK is a fixed 3-word frame (kind, argc=1, buf_id) sent on EVERY
# consumed block (~47/s at 48 kHz) — the old msh_msg_new + msh_send pair leaked 2*48 B
# per ACK on a daemon that never frees. `buf` is a caller-supplied scratch of >= 24
# bytes (the server passes its wire read buffer, free by the time an ACK is sent) so
# there is zero per-ACK heap churn. NOTE: a *stack* buffer does NOT work here — cyrius
# sizes a bare function-local `var b[3]` as 3 BYTES (bare `var X[N]` is N bytes, not
# N*u64, for function-locals), so storing the 24-byte (3-word) ACK frame overflows it
# and corrupts the stack (measured). The element-typed form `var b: u64[3]` would be a
# true 24 B, but a caller-owned buffer keeps this alloc-free AND stack-safe, mirroring
# msh_try_read_msg's caller-provided wire buffer.
fn msh_srv_ack(fd, buf_id, buf): i64 {
    store64(buf + 0, MSH_ACK);
    store64(buf + 8, 1);
    store64(buf + 16, buf_id);
    if (msh_write_all(fd, buf, 24) < 0) { return 0 - 7; }
    return 24;
}

# Service one client slot: read + dispatch one pending message (non-blocking).
# HELLO → new stream + WELCOME; WRITE → read PCM payload into the ring; GAIN →
# set the stream volume; BYE / EOF → drop. Returns 0.
fn msh_server_service(s, slot): i64 {
    var fd = load64(slot + 0);
    var stream = load64(slot + 8);

    # A WRITE payload deferred last tick because the ring was full. Retry it FIRST,
    # and only once the ring has room — the latched nframes gives its exact length
    # so framing never desyncs. Still full → return, leaving the bytes in the
    # socket (TCP backs up → the client's write blocks = real-time pacing).
    var pending = load64(slot + 16);
    if (pending != 0) {
        var pch = msh_stream_channels(stream);
        if (msh_stream_free(stream) < pending * pch) { return 0; }
        var pn = pending * pch * 2;
        var pshm = load64(slot + 24);
        if (pshm != 0) {
            # shm-deferred (MSH_WRITE_SHM): the PCM sits in the client-owned buffer,
            # not the socket. Copy it out, feed the ring, then ACK — releasing the
            # client's single-buffer credit so it may write the next block.
            var ppcm = msh_server_pcm(s, pn);
            if (msh_shm_read(pshm, ppcm, pn) < 0) { msh_server_drop(s, slot); return 0; }
            msh_stream_write(stream, ppcm, pending);
            store64(slot + 16, 0);
            store64(slot + 24, 0);
            msh_srv_ack(fd, pshm, msh_server_rbuf(s));
            return 0;
        }
        # legacy inline-deferred (MSH_WRITE): the bytes are still in the socket.
        var pbuf = msh_server_pcm(s, pn);
        if (msh_read_exact(fd, pbuf, pn) < 0) { msh_server_drop(s, slot); return 0; }
        msh_stream_write(stream, pbuf, pending);
        store64(slot + 16, 0);
        return 0;
    }

    # Reuse the server-owned message + wire buffer — this runs on EVERY active slot
    # EVERY tick (millions of idle polls/s), so a per-poll msh_msg_new here was the
    # dominant unbounded leak on a bump-allocator daemon that never frees.
    var m = msh_server_msg(s);
    var r = msh_try_read_msg(fd, m, msh_server_rbuf(s));
    if (r == 0) { return 0; }                        # nothing pending
    if (r < 0) { msh_server_drop(s, slot); return 0; } # EOF / error
    var kind = msh_msg_kind(m);
    if (kind == MSH_HELLO) {
        var st = msh_stream_new(msh_msg_arg(m, 0), msh_msg_arg(m, 1));
        var id = msh_router_add(load64(s + 8), st);
        store64(slot + 8, st);
        # Reply WELCOME by reusing the server message (its HELLO args are consumed).
        msh_msg_set(m, MSH_WELCOME, 1);
        msh_msg_set_arg(m, 0, id);
        msh_send(fd, m);
        return 0;
    }
    if (kind == MSH_WRITE) {
        if (stream == 0) { return 0; }               # WRITE before HELLO — ignore
        var nframes = msh_msg_arg(m, 0);
        var wsamp = nframes * msh_stream_channels(stream);
        # Backpressure: if the ring can't hold this chunk, LATCH nframes and leave
        # the payload in the socket (TCP backs up → the client's write blocks). A
        # chunk larger than the whole ring can never fit — read it lossily rather
        # than deadlock forever (clients are expected to keep chunks small).
        if (wsamp <= msh_stream_cap(stream) - 1) {
            if (msh_stream_free(stream) < wsamp) { store64(slot + 16, nframes); return 0; }
        }
        var pcm = msh_server_pcm(s, wsamp * 2);
        if (msh_read_exact(fd, pcm, wsamp * 2) < 0) { msh_server_drop(s, slot); return 0; }
        msh_stream_write(stream, pcm, nframes);
        return 0;
    }
    if (kind == MSH_WRITE_SHM) {
        var shframes = msh_msg_arg(m, 0);
        var shbuf    = msh_msg_arg(m, 1);
        store64(slot + 32, shbuf);       # remember the client's buffer for abnormal-drop reclaim
        # WRITE before HELLO — no stream to feed; ACK anyway so the (misbehaving)
        # client doesn't hang waiting to reclaim its buffer.
        if (stream == 0) { msh_srv_ack(fd, shbuf, msh_server_rbuf(s)); return 0; }
        var shsamp = shframes * msh_stream_channels(stream);
        # Backpressure: if the ring can't hold this block, LATCH it (frames + shm
        # buf id) and DON'T ack — the PCM stays safe in the client-owned shm buffer,
        # and the client, out of its single-buffer credit, stalls until we drain the
        # ring and ack (real-time pacing without a socket-desync risk, since nothing
        # was left half-read on the wire). A block larger than the whole ring can
        # never fit — consume it lossily rather than deadlock forever (clients keep
        # blocks <= MSH_SHM_BLOCK_FRAMES).
        if (shsamp <= msh_stream_cap(stream) - 1) {
            if (msh_stream_free(stream) < shsamp) {
                store64(slot + 16, shframes);
                store64(slot + 24, shbuf);
                return 0;
            }
        }
        var shpcm = msh_server_pcm(s, shsamp * 2);
        if (msh_shm_read(shbuf, shpcm, shsamp * 2) < 0) { msh_server_drop(s, slot); return 0; }
        msh_stream_write(stream, shpcm, shframes);
        msh_srv_ack(fd, shbuf, msh_server_rbuf(s));   # consumed -> release the client's buffer credit
        return 0;
    }
    if (kind == MSH_GAIN) {
        if (stream != 0) { msh_stream_set_gain(stream, msh_msg_arg(m, 0)); }
        return 0;
    }
    if (kind == MSH_BYE) {
        store64(slot + 32, 0);           # clean exit: the client frees its own shm buffer (avoid ABA double-free)
        msh_server_drop(s, slot);
        return 0;
    }
    return 0;
}

# Poll the server: accept one new client, then service every registered client
# once. Non-blocking — call each tick alongside msh_router_pump. Returns 0.
fn msh_server_poll(s): i64 {
    var cfd = msh_accept(load64(s + 0));
    if (cfd >= 0) { msh_server_add_client(s, cfd); }
    var tbl = load64(s + 16);
    var i = 0;
    while (i < MSH_MAX_CLIENTS) {
        if (load64(tbl + i * MSH_SLOT_SZ) != 0) { msh_server_service(s, tbl + i * MSH_SLOT_SZ); }
        i = i + 1;
    }
    return 0;
}

# Close the server: drop all clients + close the listener. Returns 0.
fn msh_server_close(s): i64 {
    var tbl = load64(s + 16);
    var i = 0;
    while (i < MSH_MAX_CLIENTS) {
        if (load64(tbl + i * MSH_SLOT_SZ) != 0) { msh_server_drop(s, tbl + i * MSH_SLOT_SZ); }
        i = i + 1;
    }
    sock_close(load64(s + 0));
    return 0;
}

# =========================================================================
# MshClient — the app-facing API: connect, write PCM, set gain, close.
# =========================================================================

enum MshClientOff {
    MSH_CL_FD       = 0;
    MSH_CL_ID       = 8;
    MSH_CL_RATE     = 16;
    MSH_CL_CH       = 24;
    MSH_CL_BUF      = 32;   # the single out-of-band shm PCM buffer id
    MSH_CL_INFLIGHT = 40;   # 1 = a block is in flight (buffer busy until ACK)
    MSH_CL_MSG      = 48;   # reused MshMsg for encode/decode — hot path allocates nothing
    MSH_CL_WBUF     = 56;   # reused wire scratch (MSH_MSG_SZ) for msh_send_buf / msh_read_msg_buf
    MSH_CL_SZ       = 64;
}

enum MshClientShm {
    # Max frames handed off per shm block. A block is copied into the one client
    # buffer, announced with MSH_WRITE_SHM, and reclaimed on MSH_ACK — so the block
    # size only bounds latency + the buffer size (MSH_SHM_BLOCK_FRAMES*ch*2 bytes),
    # NOT the TCP window (that was the old inline-WRITE 256-frame ceiling). 2048
    # stereo frames = 8 KB — trivially under the agnos single-page shm cap, and 8x
    # the old inline chunk.
    MSH_SHM_BLOCK_FRAMES = 2048;
}

# Connect to the mishran server + register a stream at rate/channels: sends HELLO,
# awaits WELCOME(stream_id). Returns a *MshClient, or 0 on failure.
fn msh_client_connect(rate, ch): i64 {
    var fd = msh_connect();
    if (fd < 0) { return 0; }
    var h = msh_msg_new();
    msh_msg_set(h, MSH_HELLO, 2);
    msh_msg_set_arg(h, 0, rate);
    msh_msg_set_arg(h, 1, ch);
    if (msh_send(fd, h) < 0) { sock_close(fd); return 0; }
    var w = msh_msg_new();
    if (msh_read_msg(fd, w) < 0) { sock_close(fd); return 0; }
    if (msh_msg_kind(w) != MSH_WELCOME) { sock_close(fd); return 0; }
    var c = alloc(MSH_CL_SZ);
    store64(c + MSH_CL_FD, fd);
    store64(c + MSH_CL_ID, msh_msg_arg(w, 0));
    store64(c + MSH_CL_RATE, rate);
    store64(c + MSH_CL_CH, ch);
    # Reserve the single out-of-band PCM buffer (one MSH_SHM_BLOCK_FRAMES block).
    # msh_client_write fills it, announces MSH_WRITE_SHM, and reuses it only after
    # the server's MSH_ACK — the flow control + reuse guard in one.
    var buf = msh_shm_create(MSH_SHM_BLOCK_FRAMES * ch * 2);
    if (buf <= 0) { sock_close(fd); return 0; }
    store64(c + MSH_CL_BUF, buf);
    store64(c + MSH_CL_INFLIGHT, 0);
    # Reusable client-owned scratch so the per-block write + per-ACK wait hot path
    # allocates NOTHING — the app-facing mirror of the server's reusable buffers
    # (msh_server_new). The bump heap has no per-object free, so a per-block alloc
    # here leaks ~192 B/block (~2 MB per 4-min song); a full playlist would OOM the
    # arena. The WELCOME message `w` (its stream-id arg already read into MSH_CL_ID
    # above) is repurposed as the reused MshMsg; a fresh MSH_MSG_SZ wire buffer backs
    # msh_send_buf / msh_read_msg_buf.
    store64(c + MSH_CL_MSG, w);
    store64(c + MSH_CL_WBUF, alloc(MSH_MSG_SZ));
    return c;
}

fn msh_client_fd(c): i64 { return load64(c + MSH_CL_FD); }
fn msh_client_id(c): i64 { return load64(c + MSH_CL_ID); }

# Block (cooperatively) until the server ACKs the in-flight buffer, clearing the
# in-flight flag so the buffer may be reused. Loops reading control messages until
# the ACK arrives (after WELCOME the server sends only MSH_ACK). On agnos each
# read cooperatively yields (msh_read_msg_buf) so the server runs to drain + ack — a
# full server ring simply defers the ack, stalling the client in real-time pace.
# Returns 0, or -6 on EOF / error.
fn msh_client_wait_ack(c): i64 {
    var fd   = load64(c + MSH_CL_FD);
    var m    = load64(c + MSH_CL_MSG);    # reused — was a per-read msh_msg_new leak
    var wbuf = load64(c + MSH_CL_WBUF);
    while (load64(c + MSH_CL_INFLIGHT) != 0) {
        if (msh_read_msg_buf(fd, m, wbuf) < 0) { return 0 - 6; }
        if (msh_msg_kind(m) == MSH_ACK) { store64(c + MSH_CL_INFLIGHT, 0); }
    }
    return 0;
}

# Write `nframes` interleaved S16 frames from `pcm` to the client's stream, over
# shared memory (the PCM never touches the TCP wire — only the tiny MSH_WRITE_SHM
# control message does). Splits into <= MSH_SHM_BLOCK_FRAMES blocks; each block
# reuses the one client buffer, so it waits for the prior block's ACK before
# overwriting (the server copies a block out BEFORE acking, so reuse-after-ack is
# race-free, and a full ring defers the ack = automatic real-time pacing).
# Returns 0, or -7 on a send / shm error.
fn msh_client_write(c, pcm, nframes): i64 {
    var fd   = load64(c + MSH_CL_FD);
    var ch   = load64(c + MSH_CL_CH);
    var buf  = load64(c + MSH_CL_BUF);
    var m    = load64(c + MSH_CL_MSG);             # reused — was a per-block msh_msg_new leak
    var wbuf = load64(c + MSH_CL_WBUF);            # reused wire scratch for msh_send_buf
    var off = 0;                                   # frames already handed off
    while (off < nframes) {
        var chunk = nframes - off;
        if (chunk > MSH_SHM_BLOCK_FRAMES) { chunk = MSH_SHM_BLOCK_FRAMES; }
        # wait_ack reuses the same MSH_CL_MSG/MSH_CL_WBUF, but it runs to completion
        # (reads the ACK into m) BEFORE we rebuild m as WRITE_SHM below — sequential,
        # so the single reused scratch is safe.
        if (load64(c + MSH_CL_INFLIGHT) != 0) {
            if (msh_client_wait_ack(c) < 0) { return 0 - 7; }
        }
        if (msh_shm_write(buf, pcm + off * ch * 2, chunk * ch * 2) < 0) { return 0 - 7; }
        msh_msg_set(m, MSH_WRITE_SHM, 2);
        msh_msg_set_arg(m, 0, chunk);
        msh_msg_set_arg(m, 1, buf);
        if (msh_send_buf(fd, m, wbuf) < 0) { return 0 - 7; }
        store64(c + MSH_CL_INFLIGHT, 1);
        off = off + chunk;
    }
    return 0;
}

# Set this stream's Q8 gain (256 = unity, 0 = mute). Returns 0 / -7.
fn msh_client_gain(c, gain): i64 {
    var fd   = load64(c + MSH_CL_FD);
    var m    = load64(c + MSH_CL_MSG);             # reused (a player may re-set volume repeatedly)
    var wbuf = load64(c + MSH_CL_WBUF);
    msh_msg_set(m, MSH_GAIN, 1);
    msh_msg_set_arg(m, 0, gain);
    if (msh_send_buf(fd, m, wbuf) < 0) { return 0 - 7; }
    return 0;
}

# Say BYE, free the out-of-band buffer, and close the connection. Returns 0. A
# still-in-flight final block may be lost (the server drops the stream on BYE /
# on a failed read of the freed buffer) — inconsequential at shutdown.
fn msh_client_close(c): i64 {
    var fd   = load64(c + MSH_CL_FD);
    var m    = load64(c + MSH_CL_MSG);             # reused (no reason to alloc at shutdown)
    var wbuf = load64(c + MSH_CL_WBUF);
    msh_msg_set(m, MSH_BYE, 0);
    msh_send_buf(fd, m, wbuf);
    var buf = load64(c + MSH_CL_BUF);
    if (buf > 0) { msh_shm_free(buf); }
    sock_close(fd);
    return 0;
}
