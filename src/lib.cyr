# @public — mishran library include chain.
# mishran (मिश्रण — mixing / mixture) — pure-Cyrius software audio mixer +
# routing server. Fans many per-app PCM streams into ONE mixed/resampled
# output writer to vani (ALSA/OSS on Linux, snd #64-69 on agnos). Owns the
# single hardware writer so a desktop with more than one sounding app works
# — PulseAudio/PipeWire's role done sovereignly with no daemon bloat.
#
# Stdlib includes live ONLY in this file — domain modules are flat, which
# is what makes `cyrius distlib` (strip-include concatenation) produce a
# compile-clean `dist/mishran.cyr`. Don't add stdlib includes in individual
# src/*.cyr files.

# ================================================================
# Standard library
# ================================================================
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/bench.cyr"

# thread.cyr (mutex_* / clone-based) precedes fnptr — the router pump loop
# runs on its own thread once the real vani sink is wired, and per-stream
# callback dispatch goes through fnptr.
include "lib/thread.cyr"
include "lib/fnptr.cyr"

# result + net — the server transport (transport.cyr) speaks TCP over loopback
# via net.cyr, whose Result return type comes from result.cyr.
include "lib/result.cyr"
include "lib/net.cyr"

# ================================================================
# vani — the audio output sink (core `audio_*` PCM shim).
# VENDORED single file (vendor/vani-core.cyr) produced from vani's
# `dist/vani-core.cyr` bundle, NOT a git `[deps.vani]` dep: since vani's
# 0.9.9 all-stdlib cut, resolving vani as a git dep drags in its whole
# `[deps].stdlib` (yukti/patra/chrono) even though the core shim only needs
# the base stdlib set already declared above. Vendoring compiles just the shim
# against mishran's own stdlib list. Mirrors cyrius-doom / -polyomino / -bb.
# (Provenance: vani 1.1.0.) route.cyr calls audio_open_playback /
# audio_set_params / audio_write / audio_prepare / audio_drain / audio_close, plus
# audio_write_nb / audio_avail (the non-blocking sink API new in vani 1.1.0, used by
# the cooperative msh_router_pump_nb) — so this must precede src/route.cyr.
# ================================================================
include "vendor/vani-core.cyr"

# ================================================================
# mishran domain modules — flat, dependency order.
# error.cyr is dep-free. stream.cyr (MshStream + ring buffer) builds on
# error.cyr; mix.cyr (msh_mix fan-in + resample stub) consumes streams;
# route.cyr (MshRouter — the single-writer sink owner) drives mix over its
# registered streams.
# ================================================================
include "src/error.cyr"
include "src/stream.cyr"
include "src/mix.cyr"
include "src/route.cyr"

# Server modules — "route through the mixer" over TCP loopback. proto.cyr (wire
# messages) is dep-free; transport.cyr (TCP via net.cyr) uses it; server.cyr
# (accept + dispatch + the app-facing client API) drives the router.
include "src/proto.cyr"
include "src/transport.cyr"
include "src/server.cyr"
