# @public — mishran the server/client TCP transport.
#
# ⛔⛔ WRONG PREMISE — TCP-ON-LOOPBACK IS RETIRED AS A LOCAL TRANSPORT (2026-08-03).
# This file was modeled 1:1 on setu's reference transport, and it inherited setu's mistake.
# On agnos the handshake could not close on an ordinary boot: every outbound segment claimed
# `net_ip` as its source, so a SYN to 127.0.0.1 was answered on a 4-tuple the client's own conn
# could never match. The only agnos runs that ever passed did so under the
# `MISHRAN_DUPLEX_SELFTEST` kernel hook, which assigned `net_ip = 0x7F000001` and made src and
# dst agree by accident. That hook and its smokes are DELETED, and every "two-proc audio on
# agnos" green resting on them is a FALSE GREEN (see this repo's CHANGELOG retractions).
# ⛔ The claim below — "cross-platform by construction ... the same wire runs on Linux and the
# sovereign kernel" — WAS FALSE for agnos. The replacement is the agnos socket (`naadi`), agnos
# `docs/development/planning/ipc.md` §9/§10; per §10.3 this whole socket body comes out,
# including the `SO_REUSEADDR` that exists only to survive a restart race a placed channel
# cannot have. Do NOT build on this file, and do NOT copy it into a new local IPC path.
# ⚠ TCP itself is fine FOR THE NETWORK — what died is a local transport riding it.
#
# transport.cyr — TCP over loopback (127.0.0.1 : MSH_TCP_PORT) via the cyrius
# `net.cyr` socket layer. net.cyr routes to Linux BSD sockets on the host AND to agnos's kernel
# TCP band (sock_connect #47 / sock_listen #56 / sock_accept #57, tagged-fd send/recv #48/#49)
# on agnos.
#
# Two agnos socket semantics the framing absorbs (both #ifdef-guarded so Linux is
# byte-identical): sock_recv (#49) is NON-BLOCKING with INVERTED signals
# (0 = would-block, -1 = EOF) vs Linux (0 = EOF, -1 = EAGAIN on a nonblocking fd);
# sock_send (#48) may send < len, so writes loop.

var MSH_TCP_PORT = 7701;   # mishran's well-known loopback audio-server port (setu = 7700)

# Connect to the mishran server (loopback : MSH_TCP_PORT). Returns the connected
# fd (>= 0), or -2 (socket) / -3 (connect).
fn msh_connect(): i64 {
    var s = tcp_socket();
    if (is_ok(s) == 0) { return 0 - 2; }
    var fd = result_unwrap(s);
    if (is_ok(sock_connect(fd, INADDR_LOOPBACK(), MSH_TCP_PORT)) == 0) {
        sock_close(fd);
        return 0 - 3;
    }
    return fd;
}

# Bind + listen on the mishran endpoint. Returns the listening fd (>= 0), or
# -2 (socket) / -3 (bind) / -4 (listen). Non-blocking so msh_accept polls.
fn msh_listen(): i64 {
    var s = tcp_socket();
    if (is_ok(s) == 0) { return 0 - 2; }
    var fd = result_unwrap(s);
    #ifndef CYRIUS_TARGET_AGNOS
    sock_reuse(fd);                                  # SO_REUSEADDR — rebind after a restart
    #endif
    if (is_ok(sock_bind(fd, INADDR_LOOPBACK(), MSH_TCP_PORT)) == 0) { sock_close(fd); return 0 - 3; }
    if (is_ok(sock_listen(fd, 8)) == 0) { sock_close(fd); return 0 - 4; }
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(fd);                        # accept polls (agnos accept is already non-blocking)
    #endif
    return fd;
}

# Accept the next pending client on `sfd`. Returns the client fd (>= 0), or -5
# when none is pending. Non-blocking on both targets. The accepted fd is set
# non-blocking (Linux) so the server can poll each client without stalling.
fn msh_accept(sfd): i64 {
    var a = sock_accept(sfd);
    if (is_ok(a) == 0) { return 0 - 5; }             # EAGAIN / no client pending
    var cfd = result_unwrap(a);
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(cfd);
    #endif
    return cfd;
}

# Write EXACTLY `n` bytes from `buf` to `fd`, looping over partial sends. Returns
# `n` (>= 0) or -7 on a write error.
fn msh_write_all(fd, buf, n): i64 {
    var sent = 0;
    while (sent < n) {
        var w = sys_write(fd, buf + sent, n - sent);
        if (w < 0) { return 0 - 7; }                # hard error / peer closed
        if (w == 0) {                               # would-block (send window full)
            #ifdef CYRIUS_TARGET_AGNOS
            sys_sched_yield();                      # DONATE the slice so the server drains the ring.
            # Must be sched_yield #44, NOT sleep_ms: sleep_ms holds preempt off, so a
            # client whose send window is full would spin-sleep without ever letting the
            # server run to drain it — a deadlock (agnos-blocking-syscall-yield-fix).
            #endif
        } else {
            sent = sent + w;
        }
    }
    return n;
}

# Encode `m` into the caller-supplied wire buffer `buf` (>= MSH_MSG_SZ) and write
# the whole frame — ALLOC-FREE, for hot paths (the client's per-block write) that
# must not churn the bump heap: on a bump allocator with no per-object free, a
# per-block alloc leaks unboundedly and a long-running player OOMs. Returns bytes
# written (> 0), an encode error (< 0), or -7 on a write error. Mirrors the server's
# msh_srv_ack / msh_try_read_msg caller-owned-buffer pattern.
fn msh_send_buf(fd, m, buf): i64 {
    var enc = msh_encode(m, buf, MSH_MSG_SZ);
    if (enc < 0) { return enc; }
    if (msh_write_all(fd, buf, enc) < 0) { return 0 - 7; }
    return enc;
}

# Allocating convenience wrapper over msh_send_buf — for ONE-SHOT callers (the
# connect HELLO, the server's WELCOME reply) where a single bump alloc never
# accumulates. Hot paths pass their own reused buffer to msh_send_buf directly.
fn msh_send(fd, m): i64 {
    return msh_send_buf(fd, m, alloc(MSH_MSG_SZ));
}

# Blocking read of >= 1 byte into `buf` (cap `cap`). Absorbs agnos's non-blocking
# recv (0 = would-block → yield + bounded retry) vs Linux's blocking read
# (0 = EOF). Returns bytes (> 0) or -6 on EOF / error / timeout.
fn msh_read_blk(fd, buf, cap): i64 {
    var tries = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: recv is non-blocking; DONATE the slice (sched_yield #44) so the peer runs
    # to produce the bytes, then retry. Not sleep_ms — that holds preempt off and would
    # keep the peer from ever running (agnos-blocking-syscall-yield-fix). The cap is a
    # generous safety net against a silent-but-alive peer (a dead peer returns r<0 and
    # breaks immediately); each yield is a full peer-slice, so this is far longer than
    # the old 5000*2ms wall clock without falsely timing out a cooperative exchange.
    while (tries <= 2000000) {
        var r = sys_read(fd, buf, cap);
        if (r < 0) { return 0 - 6; }               # -1 = EOF / error
        if (r > 0) { return r; }                   # got bytes
        tries = tries + 1;                          # r == 0 → would-block
        sys_sched_yield();
    }
    return 0 - 6;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    while (tries <= 2000000) {                       # Linux: nonblocking fd → busy-spin on EAGAIN
        var r = sys_read(fd, buf, cap);             # (loopback delivers in microseconds; bounded)
        if (r == 0) { return 0 - 6; }              # 0 = EOF on Linux
        if (r > 0) { return r; }                   # got bytes
        tries = tries + 1;                          # r < 0 = EAGAIN
    }
    return 0 - 6;
    #endif
}

# Read EXACTLY `n` bytes into `buf`, looping over short/would-block reads. Returns
# `n` (>= 0) or -6 on EOF/error.
fn msh_read_exact(fd, buf, n): i64 {
    var got = 0;
    while (got < n) {
        var r = msh_read_blk(fd, buf + got, n - got);
        if (r <= 0) { return 0 - 6; }
        got = got + r;
    }
    return got;
}

# Blocking read of ONE length-framed message into `m` (header gives argc → total
# (2+argc)*8 bytes) using the caller-supplied wire buffer `buf` (>= MSH_MSG_SZ) —
# ALLOC-FREE, the read mirror of msh_send_buf for the client's per-ACK wait loop.
# Returns the frame length (> 0), -6 on EOF/short read, or -1 on a bad frame.
fn msh_read_msg_buf(fd, m, buf): i64 {
    if (msh_read_exact(fd, buf, 16) < 0) { return 0 - 6; }
    var argc = load64(buf + 8);
    if (argc < 0) { return 0 - 1; }
    if (argc > MSH_MAX_ARGS) { return 0 - 1; }
    var total = (2 + argc) * 8;
    if (total > 16) {
        if (msh_read_exact(fd, buf + 16, total - 16) < 0) { return 0 - 6; }
    }
    return msh_decode(buf, total, m);
}

# Allocating convenience wrapper over msh_read_msg_buf — for the ONE-SHOT client
# WELCOME handshake. The per-ACK wait loop passes its reused buffer to
# msh_read_msg_buf directly.
fn msh_read_msg(fd, m): i64 {
    return msh_read_msg_buf(fd, m, alloc(MSH_MSG_SZ));
}

# NON-BLOCKING read of ONE message into `m` for the server poll. Returns 1 with a
# decoded message, 0 when nothing is pending (would-block), or -1 on EOF/error.
# Once a header byte arrives the rest is read blocking (bounded), so a message is
# never left half-consumed. `buf` is a caller-supplied wire scratch buffer of >=
# MSH_MSG_SZ bytes (the server owns one reusable buffer) — this is polled on EVERY
# slot EVERY tick, so allocating it here would leak unboundedly on a long daemon.
fn msh_try_read_msg(fd, m, buf): i64 {
    var r = sys_read(fd, buf, 16);
    #ifdef CYRIUS_TARGET_AGNOS
    if (r == 0) { return 0; }                      # would-block → nothing pending
    if (r < 0)  { return 0 - 1; }                  # EOF / error
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (r < 0)  { return 0; }                      # EAGAIN on a nonblocking fd → nothing pending
    if (r == 0) { return 0 - 1; }                  # EOF on Linux
    #endif
    if (r < 16) { if (msh_read_exact(fd, buf + r, 16 - r) < 0) { return 0 - 1; } }
    var argc = load64(buf + 8);
    if (argc < 0) { return 0 - 1; }
    if (argc > MSH_MAX_ARGS) { return 0 - 1; }
    var total = (2 + argc) * 8;
    if (total > 16) { if (msh_read_exact(fd, buf + 16, total - 16) < 0) { return 0 - 1; } }
    if (msh_decode(buf, total, m) < 0) { return 0 - 1; }
    return 1;
}
