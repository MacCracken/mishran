# TEMP measurement module (included-module context, like server.cyr).
# Definitively brackets the byte capacity of a function-local `var X[N]`
# using neighbour guards. DELETE after measuring.

# Can I store K u64 words into `var b[3]` without corrupting a neighbour?
# Returns a bitmask: bit0 set if the guard BEFORE was clobbered, bit1 if the
# guard AFTER was clobbered, after writing `words` u64 words into b[3].
fn _measure_b3_words(words): i64 {
    var g_before = 111111;
    var b[3];
    var g_after = 222222;
    var i = 0;
    while (i < words) { store64(&b + i * 8, 7); i = i + 1; }
    var mask = 0;
    if (g_before != 111111) { mask = mask + 1; }
    if (g_after != 222222) { mask = mask + 2; }
    return mask;
}

# Same for a `var p[48]` (mimicking shm.cyr's path buffer): write `bytes`
# bytes and report which guard (if any) got clobbered.
fn _measure_p48_bytes(bytes): i64 {
    var g_before = 111111;
    var p[48];
    var g_after = 222222;
    var i = 0;
    while (i < bytes) { store8(&p + i, 65); i = i + 1; }
    var mask = 0;
    if (g_before != 111111) { mask = mask + 1; }
    if (g_after != 222222) { mask = mask + 2; }
    return mask;
}
