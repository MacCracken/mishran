# @public — mishran the single-writer router / fan-in server.
# route.cyr — the MshRouter owns the ONE hardware output sink (a vani
# handle) and the list of registered app streams. It is the answer to the
# agnos snd surface being single-writer: exactly one MshRouter holds that
# writer, and every app's MshStream fans in behind it via msh_mix.
#
# Lifecycle:
#   msh_router_new()            — allocate a router (sink not yet open)
#   msh_router_add(r, stream)   — register an app stream, assign an id
#   msh_router_remove(r, id)    — drop a stream by id
#   msh_router_pump(r)          — pull each stream → msh_mix → push to sink
#
# The pump loop is what runs on the router's own thread once the real vani
# sink is wired; at scaffold stage it mixes into an internal buffer and
# stops short of the device write.

# Max registered streams for the scaffold (fixed table; grows to a vec later).
enum MshRouterCap {
    MSH_MAX_STREAMS = 32;
    MSH_PUMP_FRAMES = 1024;   # frames mixed per pump tick
    # Budget of NO-PROGRESS sink-write attempts per pump tick (a zero-frame
    # write or an XRUN re-prepare). Attempts that accept frames are free, so a
    # slow-but-draining sink is never failed; only a stalled one is.
    MSH_PUMP_WRITE_TRIES = 16;
}

# ----------------------------------------------------------------
# MshRouter struct layout (80 bytes):
#   +0:  sink       — vani sink handle (0 = no sink open yet)
#   +8:  streams    — ptr to array of MSH_MAX_STREAMS stream ptrs (8 each)
#   +16: count      — number of registered streams
#   +24: next_id    — monotonic id allocator
#   +32: channels   — sink channel count (default 2, stereo)
#   +40: rate       — sink sample rate (default 48000)
#   +48: master     — master output volume, Q8 (256 = unity, 0 = mute)
#   +56: mixbuf     — router-owned mixdown buffer  (MSH_PUMP_FRAMES * ch samples)
#   +64: mixscratch — router-owned per-stream pull (MSH_PUMP_FRAMES * ch samples)
#   +72: inbuf      — router-owned resample pull   (_msh_inbuf_frames() * ch samples)
#
# ⚠ GREW FROM 56 TO 80 BYTES IN 0.5.6. The last three are the repair for the pump's
# per-tick allocation: mixbuf came from an alloc() inside msh_router_pump and the other
# two from allocs inside msh_mix, on every tick, against a stdlib allocator that has NO
# free(). At MSH_PUMP_FRAMES=1024 and 48 kHz that is ~47 permanently-retained buffers a
# second — the daemon grew without bound for as long as it played audio. They are now
# allocated ONCE here and reused, which is the same discipline msh_server_new already
# applied to the serving half. Nothing outside this file should depend on the layout:
# every field is reached through an accessor, and the in-tree consumers (jalwa included)
# only ever call the msh_router_* API.
# ----------------------------------------------------------------

# Worst-case resample pull, in FRAMES, for one pump tick at `sink_rate`.
#
# msh_mix pulls (frames * stream_rate) / sink_rate source frames to produce `frames`
# output frames, so the largest pull comes from the highest stream rate the server
# will accept — MSH_MAX_RATE, enforced at HELLO (see stream.cyr's MshFormatBounds).
# That validation is what makes this bound STATIC and therefore pre-allocatable; if
# the accepted rate band ever widens, this grows with it automatically.
fn _msh_inbuf_frames(sink_rate): i64 {
    if (sink_rate < 1) { return MSH_PUMP_FRAMES; }
    var f = (MSH_PUMP_FRAMES * MSH_MAX_RATE) / sink_rate;
    if (f < MSH_PUMP_FRAMES) { f = MSH_PUMP_FRAMES; }
    return f;
}

# Allocate a router with an empty stream table and no sink.
# Returns a MshRouter ptr, or 0 on allocation failure.
fn msh_router_new(): i64 {
    var r = alloc(80);
    if (r == 0) { return 0; }
    var tbl = alloc(MSH_MAX_STREAMS * 8);
    if (tbl == 0) { return 0; }
    var i = 0;
    while (i < MSH_MAX_STREAMS) {
        store64(tbl + i * 8, 0);
        i = i + 1;
    }
    store64(r + 0, 0);            # sink — opened later via vani
    store64(r + 8, tbl);
    store64(r + 16, 0);          # count
    store64(r + 24, 1);          # next_id starts at 1
    store64(r + 32, 2);          # channels — stereo
    store64(r + 40, 48000);      # rate
    store64(r + 48, 256);        # master output gain — Q8 unity

    # The pump's whole working set, allocated ONCE. Sized from the router's own
    # geometry (set just above) and from the HELLO-enforced rate ceiling, so no wire
    # value can ever demand a bigger one — that is what makes pre-allocation sound.
    # Three DISTINCT allocations rather than one carved block: an overrun of any of
    # them must not silently land in a live neighbour.
    var blk = MSH_PUMP_FRAMES * 2 * 2;                       # frames * stereo * 2 B
    var mixbuf = alloc(blk);
    if (mixbuf == 0) { return 0; }
    var mixscratch = alloc(blk);
    if (mixscratch == 0) { return 0; }
    var inbuf = alloc(_msh_inbuf_frames(48000) * 2 * 2);
    if (inbuf == 0) { return 0; }
    store64(r + 56, mixbuf);
    store64(r + 64, mixscratch);
    store64(r + 72, inbuf);
    return r;
}

# Accessors.
fn msh_router_sink(r): i64      { return load64(r + 0); }
fn msh_router_streams(r): i64   { return load64(r + 8); }
fn msh_router_count(r): i64     { return load64(r + 16); }
fn msh_router_channels(r): i64  { return load64(r + 32); }
fn msh_router_rate(r): i64      { return load64(r + 40); }

# Master output volume, Q8 fixed-point (256 = unity, 128 = -6 dB, 0 = mute).
# Applied to the mixed block in msh_router_pump just before the sink write.
fn msh_router_gain(r): i64      { return load64(r + 48); }
fn msh_router_set_gain(r, g): i64 { store64(r + 48, g); return 0; }

# Open the vani hardware sink for this router. `card`/`device` select the ALSA
# PCM endpoint (both ignored on agnos, where the sovereign snd stream is
# claimed). Configures the sink to the router's rate/channels at S16_LE and
# prepares it. Idempotent — a second call with a sink already open is a no-op.
# Returns MISHRAN_OK, or MISHRAN_ERR_NO_SINK if the device could not be opened
# or configured.
fn msh_router_open(r, card, device): i64 {
    if (r == 0)             { return MISHRAN_ERR_NO_SINK; }
    if (load64(r + 0) != 0) { return MISHRAN_OK; }
    var dev = audio_open_playback(card, device);
    if (dev == 0)           { return MISHRAN_ERR_NO_SINK; }
    var rc = audio_set_params(dev, msh_router_rate(r), msh_router_channels(r), 16);
    if (rc < 0) {
        audio_close(dev);
        return MISHRAN_ERR_NO_SINK;
    }
    audio_prepare(dev);
    store64(r + 0, dev);
    return MISHRAN_OK;
}

# Register a stream. Assigns it the next id, stores it in the first free slot,
# bumps count. Returns the assigned stream id (ALWAYS >= 1), or a NEGATIVE error.
#
# ⚠ RETURN CONTRACT CHANGED IN 0.5.6. This used to return `MISHRAN_ERR_OOM` on a
# full table — and MISHRAN_ERR_OOM is literally 1, while next_id starts at 1, so
# "table full" was BIT-IDENTICAL to "here is your stream, id 1". A caller could not
# tell the two apart, and server.cyr duly sent that 1 back as a WELCOME id. Failure
# is now negative so `id < 0` is a reliable test. Callers testing the old
# `id == MISHRAN_ERR_OOM` must move to `id < 0`; in-tree callers ignore the return.
#
# The stream == 0 guard is defence in depth: msh_stream_set_id would store64 through
# a null pointer (measured: SIGSEGV), and the only way to get here with 0 was an
# unchecked msh_stream_new — which server.cyr now checks too.
fn msh_router_add(r, stream): i64 {
    if (stream == 0) { return 0 - MISHRAN_ERR_NO_STREAM; }
    var tbl = load64(r + 8);
    var i = 0;
    while (i < MSH_MAX_STREAMS) {
        if (load64(tbl + i * 8) == 0) {
            var id = load64(r + 24);
            msh_stream_set_id(stream, id);
            store64(tbl + i * 8, stream);
            store64(r + 24, id + 1);
            store64(r + 16, load64(r + 16) + 1);
            return id;
        }
        i = i + 1;
    }
    return 0 - MISHRAN_ERR_OOM;
}

# Remove a stream by id. Returns MISHRAN_OK, or MISHRAN_ERR_NO_STREAM if the
# id was not registered.
fn msh_router_remove(r, id): i64 {
    var tbl = load64(r + 8);
    var i = 0;
    while (i < MSH_MAX_STREAMS) {
        var s = load64(tbl + i * 8);
        if (s != 0) {
            if (msh_stream_id(s) == id) {
                store64(tbl + i * 8, 0);
                store64(r + 16, load64(r + 16) - 1);
                return MISHRAN_OK;
            }
        }
        i = i + 1;
    }
    return MISHRAN_ERR_NO_STREAM;
}

# Mix ONE block into the router's own mixbuf and apply the master level — everything
# a pump tick does EXCEPT touching the device. Both pumps go through this, so they
# cannot drift apart, and it is the seam that makes the mix stage testable on a host
# with no audio hardware (programs/pumpleak_test.cyr drives exactly this).
#
# ALLOCATION-FREE by construction: every buffer it needs is router-owned and was
# allocated once in msh_router_new. Do not reintroduce an alloc here — see the struct
# layout note above for what that cost before 0.5.6.
# Returns MISHRAN_OK, or an error from the mix itself.
fn msh_router_mixtick(r): i64 {
    var ch = load64(r + 32);
    if (ch < 1) { return MISHRAN_ERR_FORMAT; }
    var total = MSH_PUMP_FRAMES * ch;
    var rc = msh_mix_ws(load64(r + 8), MSH_MAX_STREAMS, load64(r + 56),
      MSH_PUMP_FRAMES, load64(r + 40), ch,
      load64(r + 64), load64(r + 72),
      _msh_inbuf_frames(load64(r + 40)));
    if (rc != MISHRAN_OK) { return rc; }
    # Apply the master output level to the mixed block (Q8; no-op at unity).
    msh_apply_gain(load64(r + 56), total, load64(r + 48));
    return MISHRAN_OK;
}

# One pump tick: mix a block (msh_router_mixtick) and push it to the vani sink. The sink must
# already be open (msh_router_open); a router with no sink returns
# MISHRAN_ERR_NO_SINK so the caller knows the block was mixed but not emitted.
# Returns MISHRAN_OK on a clean mix + write, or an error code.
#
# BLOCKING: the sink write blocks until the DAC can take the block, so a SINGLE-PROC
# feed+pump loop (e.g. mishtone) is PACED to real time by this call. A multi-proc
# daemon serving concurrent client procs must use msh_router_pump_nb instead — a
# blocking write there holds the CPU with preemption disabled and starves the client
# (the kernel can't preempt a blocking syscall — agnos-blocking-syscall-yield-fix).
# TODO(v0.2): run this loop on the router's own thread; reuse a router-owned
#       mixbuf instead of the per-tick alloc below.
fn msh_router_pump(r): i64 {
    var ch = load64(r + 32);
    var total = MSH_PUMP_FRAMES * ch;
    var rc = msh_router_mixtick(r);
    if (rc != MISHRAN_OK) { return rc; }
    var mixbuf = load64(r + 56);

    # Push the mixed block to the vani sink. audio_write returns the frame count
    # ACCEPTED — which may be SHORT of what we asked for — or negative on error;
    # -EPIPE (0 - 32) is an ALSA underrun — re-prepare and replay the remainder
    # (the doom/dhvani idiom, since the core audio_* shim leaves XRUN recovery to
    # the caller).
    #
    # We must drain the WHOLE block here: msh_mix above already CONSUMED these
    # frames out of every stream ring, and mixbuf is a per-tick allocation that is
    # never revisited, so anything we don't hand the device is destroyed. vani hit
    # this same bug shape in vani_play_from_ring and fixed it at 1.2.0 ("destroyed
    # audio on any short write"); upstream could peek-then-consume against the
    # caller's ring, but a mixdown has no ring to un-consume — so mishran's policy
    # is instead to loop on the remainder, advancing by the accepted count, and to
    # report MISHRAN_ERR_SINK_SHORT rather than silently drop frames.
    var sink = load64(r + 0);
    if (sink == 0) { return MISHRAN_ERR_NO_SINK; }
    var bpf = ch * 2;             # bytes per frame — S16_LE interleaved
    var done = 0;                 # frames the sink has accepted so far
    var stalls = 0;               # no-progress attempts spent (see MSH_PUMP_WRITE_TRIES)
    while (done < MSH_PUMP_FRAMES) {
        var w = audio_write(sink, mixbuf + done * bpf, MSH_PUMP_FRAMES - done);
        if (w == 0 - 32) {
            # Underrun: re-prepare and replay from where the device stopped.
            audio_prepare(sink);
            stalls = stalls + 1;
            if (stalls > MSH_PUMP_WRITE_TRIES) { return MISHRAN_ERR_SINK_SHORT; }
            continue;
        }
        if (w < 0) { return MISHRAN_ERR_SINK_WRITE; }
        if (w == 0) {
            stalls = stalls + 1;
            if (stalls > MSH_PUMP_WRITE_TRIES) { return MISHRAN_ERR_SINK_SHORT; }
            continue;
        }
        done = done + w;
    }
    return MISHRAN_OK;
}

# Cooperative, NON-blocking pump for a MULTI-PROC daemon (mishrand / mishduplex) that
# services concurrent client procs. On agnos: emit a block ONLY when the DAC ring has
# room for a WHOLE block (audio_avail #69); otherwise return WITHOUT mixing, so the
# stream data stays buffered and the daemon loop can go back to msh_server_poll +
# sched_yield. This is the crux of multi-proc audio: a blocking audio_write — or a
# loop-until-whole-block write — would HOG the pump, stop draining the concurrent
# client, and starve the mix into silence (the kernel can't preempt a blocking syscall:
# the shared per-CPU syscall kstack, the serial-kstack invariant —
# agnos-blocking-syscall-yield-fix). We write at most one block per call, DAC-paced, so
# the daemon stays responsive and the procs interleave; the DAC IRQ draining the ring
# paces us. On Linux (real preemption) this delegates to the blocking pump.
fn msh_router_pump_nb(r): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var sink = load64(r + 0);
    if (sink == 0) { return MISHRAN_ERR_NO_SINK; }
    if (audio_avail(sink) < MSH_PUMP_FRAMES) { return MISHRAN_OK; }   # no room yet -> next tick
    var rc = msh_router_mixtick(r);
    if (rc != MISHRAN_OK) { return rc; }
    var mixbuf = load64(r + 56);
    var wn = audio_write_nb(sink, mixbuf, MSH_PUMP_FRAMES);   # room was checked -> full block fits
    if (wn < 0) { return MISHRAN_ERR_SINK_WRITE; }
    # A SHORT write here is anomalous — audio_avail said a whole block fit, and the
    # DAC IRQ only ever frees more room (the router is the single hardware writer,
    # so nothing else consumes it). But msh_mix already consumed these frames and
    # this pump must NOT loop to drain the rest: a loop-until-whole-block write is
    # exactly what would hog the pump and starve the concurrent client proc (see the
    # header above). So we report the loss instead of retrying it — same policy as
    # the blocking pump, minus the retries it can afford.
    if (wn < MSH_PUMP_FRAMES) { return MISHRAN_ERR_SINK_SHORT; }
    return MISHRAN_OK;
    #else
    return msh_router_pump(r);
    #endif
}

# Drain and close the vani sink, releasing the single hardware writer. Safe to
# call when no sink is open (no-op). After this the router can be re-opened
# with msh_router_open. Returns MISHRAN_OK.
fn msh_router_close(r): i64 {
    if (r == 0) { return MISHRAN_OK; }
    var sink = load64(r + 0);
    if (sink != 0) {
        audio_drain(sink);
        audio_close(sink);
        store64(r + 0, 0);
    }
    return MISHRAN_OK;
}
