# @public — mishran the mixing kernel.
# mix.cyr — sum many per-app streams into a single output frame buffer
# (fan-in), plus a resample stub. This is where the "many streams → one
# writer" fan-in actually happens numerically.
#
# msh_mix sums the S16 samples of `n` streams frame-by-frame into `out`
# with a hard clamp to the S16 range so a loud overlap doesn't wrap, each
# stream scaled by its per-stream Q8 gain first. A REAL (if simple) mixer
# body — per-stream gain now; no dither, no soft-knee yet.

# S16 sample bounds. Cyrius enum members must be plain numbers (no unary
# minus), so the minimum is expressed as `0 - 32768` inside the clamp.
enum MshS16 {
    MSH_S16_MAX = 32767;
    # Q8 gain ceiling (+24 dB). A gain is wire-supplied, and `sample * gain` is a
    # plain i64 multiply evaluated BEFORE msh_clamp_s16 ever sees it — so a gain
    # above roughly 2^48 wraps the product and the clamp then faithfully saturates
    # an already-garbage value, often to the WRONG rail (a phase-inverted full-scale
    # square wave rather than a loud one). Bounding the gain keeps the multiply in
    # range; 4096 is +24 dB, far past any legitimate use.
    MSH_MAX_GAIN_Q8 = 4096;
}

# Clamp an accumulated i64 sample into the signed-16-bit range.
fn msh_clamp_s16(v): i64 {
    var lo = 0 - 32768;
    if (v > MSH_S16_MAX) { return MSH_S16_MAX; }
    if (v < lo) { return lo; }
    return v;
}

# Sign-extend a raw 16-bit sample (load16 gives an unsigned 0..65535) into
# a signed i64 so the summation arithmetic is correct.
fn msh_sext_s16(u): i64 {
    if (u >= 32768) { return u - 65536; }
    return u;
}

# Linear-resample `src_frames` interleaved S16 frames (`ch` channels) at
# `in_rate` into `out` at `out_rate`, up to `out_cap` frames. Per-channel
# linear interpolation via an integer phase accumulator (no float): output
# frame o samples source position o*in_rate/out_rate, interpolating between the
# two nearest source frames. Returns the output frame count produced
# (= src_frames*out_rate/in_rate, capped at out_cap); in_rate == out_rate is a
# straight copy. (`in` is a Cyrius keyword, hence `src`.)
# TODO(v0.2): polyphase / anti-alias filtering on downsample; F32 path.
fn msh_resample(src, src_frames, in_rate, out, out_cap, out_rate, ch): i64 {
    if (in_rate == 0) { return 0; }
    if (src_frames <= 0) { return 0; }
    var out_frames = (src_frames * out_rate) / in_rate;
    if (out_frames > out_cap) { out_frames = out_cap; }
    var o = 0;
    while (o < out_frames) {
        var posn = o * in_rate;                 # source position numerator (out_rate units)
        var idx = posn / out_rate;              # floor source frame
        var rem = posn - idx * out_rate;        # fractional numerator, [0, out_rate)
        var idx1 = idx + 1;
        if (idx1 >= src_frames) { idx1 = src_frames - 1; }
        var c = 0;
        while (c < ch) {
            var s0 = msh_sext_s16(load16(src + (idx * ch + c) * 2));
            var s1 = msh_sext_s16(load16(src + (idx1 * ch + c) * 2));
            var interp = s0 + ((s1 - s0) * rem) / out_rate;
            store16(out + (o * ch + c) * 2, msh_clamp_s16(interp));
            c = c + 1;
        }
        o = o + 1;
    }
    return out_frames;
}

# Mix `n` streams into `out` for `frames` interleaved frames at `sink_rate`.
#   streams   — ptr to an array of n MshStream ptrs (8 bytes each)
#   out       — S16 output buffer, frames*channels samples
#   frames    — frame count to produce (at the sink rate)
#   sink_rate — the router output rate; a stream at a different rate is
#               linear-resampled to it via msh_resample before summing.
#   sink_ch   — the OUTPUT channel count. This is a property of the SINK and the
#               caller already knows it; msh_mix must never infer it.
#
# ⚠ SIGNATURE CHANGED IN 0.5.6 (added sink_ch). Before this, msh_mix took the mix
# width from stream slot 0's client-supplied channel count while msh_router_pump had
# already sized mixbuf from the SINK's. The two disagreed in both directions:
#   - slot-0 NARROWER than the sink (a mono client, which jalwa produces by default):
#     total was half of mixbuf, so the mixer wrote only the first half of every block
#     and the DAC played whatever was in the second half — uninitialised heap.
#   - slot-0 WIDER than another stream's: msh_stream_read writes at the STREAM's own
#     width into a scratch sized from slot 0's, overrunning it by that ratio.
# Each stream is scaled by its per-stream Q8 gain, up-mixed to the sink width if
# narrower, summed, and clamped. A stream that cannot be read contributes silence
# rather than failing the mixdown. Returns MISHRAN_OK, or MISHRAN_ERR_* only for a
# fault of the MIX ITSELF (bad sink width, scratch OOM) — never for one stream.
fn msh_mix_ws(streams, n, out, frames, sink_rate, sink_ch, scratch, inbuf, inbuf_frames): i64 {
    if (sink_ch < 1) { return MISHRAN_ERR_FORMAT; }
    if (frames < 1)  { return MISHRAN_OK; }
    if (scratch == 0) { return MISHRAN_ERR_OOM; }
    var total = frames * sink_ch;

    # Zero the accumulator (out doubles as the running sum in S16 space).
    var i = 0;
    while (i < total) {
        store16(out + i * 2, 0);
        i = i + 1;
    }

    var si = 0;
    while (si < n) {
        var s = load64(streams + si * 8);
        if (s != 0) {
            var sch = msh_stream_channels(s);
            # A stream WIDER than the sink cannot be represented in a buffer sized at
            # the sink width, and mishran has no down-mix path — skip it rather than
            # read it into a buffer sized for a narrower stride. The server refuses
            # such a HELLO, so this is unreachable defence in depth.
            if (sch >= 1) {
                if (sch <= sink_ch) {
                    var g = msh_stream_gain(s);              # Q8 per-stream volume (256 = unity)
                    if (g < 0)         { g = 0; }
                    if (g > MSH_MAX_GAIN_Q8) { g = MSH_MAX_GAIN_Q8; }
                    var srate = msh_stream_rate(s);
                    var got_frames = 0;
                    var scap = frames * sch;                 # samples this stream may write
                    if (srate == sink_rate) {
                        got_frames = msh_stream_read_cap(s, scratch, frames, scap);
                    } else {
                        # Pull the source frames that map to `frames` output frames, then
                        # linear-resample them up/down to the sink rate into scratch.
                        var in_frames = (frames * srate) / sink_rate;
                        if (in_frames < 1) { in_frames = 1; }
                        # Never exceed the workspace the caller sized. inbuf_frames is the
                        # worst case over the whole legal rate band (see msh_router_new), so
                        # a clamp here should be unreachable — but a stream whose rate was
                        # set by some path other than a validated HELLO must truncate, not
                        # overrun. A per-stream shortfall costs that stream some frames this
                        # tick; it never corrupts the workspace.
                        if (in_frames > inbuf_frames) { in_frames = inbuf_frames; }
                        # A per-stream failure must NOT abort the whole mixdown: before 0.5.6
                        # an alloc failure here returned MISHRAN_ERR_OOM out of msh_mix, which
                        # made the pump discard the block — so ONE stream's bad luck silenced
                        # EVERY app. Skip this stream; the others still play.
                        if (inbuf != 0) { if (in_frames >= 1) {
                                var pulled = msh_stream_read_cap(s, inbuf, in_frames, in_frames * sch);
                                got_frames = msh_resample(inbuf, pulled, srate, scratch, frames, sink_rate, sch);
                            } }
                    }
                    # Accumulate at the SINK width, up-mixing a narrower stream. A mono
                    # stream is broadcast to every output channel (source channel 0 for
                    # all of them); an equal-width stream maps channel-for-channel. This
                    # is why a mono client is ACCEPTED rather than refused: jalwa defaults
                    # to channels=1 whenever a file carries no channel count, so refusing
                    # mono would break the primary consumer.
                    var o = 0;
                    while (o < got_frames) {
                        var c = 0;
                        while (c < sink_ch) {
                            var sc = c;
                            if (sch == 1) { sc = 0; }
                            var oidx = o * sink_ch + c;
                            var sidx = o * sch + sc;
                            var acc = msh_sext_s16(load16(out + oidx * 2));
                            acc = acc + (msh_sext_s16(load16(scratch + sidx * 2)) * g) / 256;
                            store16(out + oidx * 2, msh_clamp_s16(acc));
                            c = c + 1;
                        }
                        o = o + 1;
                    }
                }
            }
        }
        si = si + 1;
    }
    return MISHRAN_OK;
}

# Allocating convenience wrapper over msh_mix_ws, for ONE-SHOT callers (probes, a
# consumer mixing a single block) where a bump allocation never accumulates. The
# per-tick audio path MUST use msh_mix_ws with router-owned buffers instead — mirrors
# msh_send / msh_send_buf and msh_stream_read / msh_stream_read_cap.
fn msh_mix(streams, n, out, frames, sink_rate, sink_ch): i64 {
    if (sink_ch < 1) { return MISHRAN_ERR_FORMAT; }
    if (frames < 1)  { return MISHRAN_OK; }
    var scratch = alloc(frames * sink_ch * 2);
    if (scratch == 0) { return MISHRAN_ERR_OOM; }
    # Worst-case resample pull across the legal rate band, same bound msh_router_new uses.
    var inf = (frames * MSH_MAX_RATE) / sink_rate;
    if (inf < 1) { inf = 1; }
    var inbuf = alloc(inf * sink_ch * 2);
    if (inbuf == 0) { return MISHRAN_ERR_OOM; }
    return msh_mix_ws(streams, n, out, frames, sink_rate, sink_ch, scratch, inbuf, inf);
}

# Scale `count` interleaved S16 samples in `buf` by a Q8 gain (256 = unity,
# 0 = mute) IN PLACE, clamping each result to the S16 range. Drives the
# router's master output level (msh_router_pump); gain == 256 is a no-op fast
# path. Pure + unit-testable without a hardware sink.
fn msh_apply_gain(buf, count, gain): i64 {
    if (gain == 256) { return MISHRAN_OK; }
    var i = 0;
    while (i < count) {
        var v = (msh_sext_s16(load16(buf + i * 2)) * gain) / 256;
        store16(buf + i * 2, msh_clamp_s16(v));
        i = i + 1;
    }
    return MISHRAN_OK;
}
