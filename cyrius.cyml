[package]
name = "mishran"
version = "${file:VERSION}"
description = "mishran (मिश्रण — mixing) — pure-Cyrius software audio mixer + routing server for AGNOS: fans many per-app PCM streams into one mixed/resampled output writer to vani (ALSA/OSS on Linux, snd #64-69 on agnos). Owns the single hardware writer so multi-app desktop audio works. No PulseAudio/PipeWire daemon."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/mishran"
language = "cyrius"
cyrius = "6.6.2"

# mishran is a library — no CLI binary yet. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# Consumers (aethersafha / desktop audio clients) pull `dist/mishran.cyr`
# via a `[deps.mishran]` entry pointing at a git tag.
[build]
entry = "programs/smoke.cyr"
output = "build/mishran-smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; stream.cyr uses it; mix.cyr uses stream; route.cyr
# owns the single sink and drives mix; then the server band — proto.cyr (wire
# messages, dep-free), transport.cyr (TCP via net.cyr), server.cyr (accept +
# dispatch + the app client). Don't reorder without re-running `cyrius distlib`
# and verifying the bundle compiles clean.
#
# Consumers: `dist/mishran.deps` is the authority for what a consumer's own
# [deps].stdlib must carry — read it, don't retype it here. ⛔ This line used to
# say "`net` + `result`" and that was an UNDER-REPORT: route.cyr calls
# audio_open_playback / audio_write_nb / audio_avail, which mishran satisfies
# in-repo from the VENDORED vendor/vani-core.cyr — but `vendor/` is NOT a [lib]
# module, so the bundle carries the CALLS with no definition and a consumer
# building from the two named leaves got undefined `audio_*`. The sidecar was
# pure inference under the old 6.5.36 pin and propagated the same gap. cyrius
# 6.5.37's COMPILE-VERIFIED sidecar caught it at the 6.6.2 bump and re-added the
# 9 missing leaves (vani + its transitive yukti/sakshi/patra/freelist/chrono/fs/
# hashmap/process), 14 -> 23. Note this is exactly the transitive set the
# vendoring above avoids for MISHRAN's build; it is unavoidable for a consumer
# of the dist, which has no vendored shim.
[lib]
modules = [
    "src/error.cyr",
    "src/stream.cyr",
    "src/mix.cyr",
    "src/route.cyr",
    "src/proto.cyr",
    "src/shm.cyr",
    "src/transport.cyr",
    "src/server.cyr",
]

[deps]
# Stdlib base set for the mixer scaffold. "thread" is present now because
# the router pump loop (route.cyr) runs on its own thread once the real
# sink is wired; "fnptr" for the eventual per-stream callback dispatch.
stdlib = [
    "string",
    "fmt",
    "alloc",
    "io",
    "args",     # io.cyr's agnos getenv path calls args_agnos.cyr's _agnos_getenv
    "vec",
    "str",
    "syscalls",
    "assert",
    "bench",
    "thread",
    "fnptr",
    "result",   # Result (Ok/Err/is_ok/result_unwrap) — net.cyr's return type
    "net",      # cross-platform TCP sockets (tcp_socket/sock_*) — the server transport
]

